---
import UiIcon from "../../components/UiIcon.astro";
import ConverterStatus from "../../components/ConverterStatus.astro";
import FormatterOptions from "../../components/FormatterOptions.astro";
import Tooltip from "../../components/Tooltip.astro";
import type { JavaScriptFormatterComponentProps } from "./contract";
import { createJavaScriptFormatterClientCopy } from "./copy";
import "./styles.css";

type Props = JavaScriptFormatterComponentProps;

const { copy, commonCopy, help, initialMode = "format" } = Astro.props;
const clientCopy = createJavaScriptFormatterClientCopy(copy, commonCopy);
---

<section
  class="converter javascript-formatter"
  data-javascript-formatter
  data-mode={initialMode}
  aria-label={copy.ariaLabel}
>
  <div class="converter-topbar javascript-formatter-topbar">
    <div class="mode-switch" role="group" aria-label={copy.modeLabel}>
      <button
        class:list={["mode-button", { "is-active": initialMode === "format" }]}
        type="button"
        data-mode-button="format"
        aria-pressed={initialMode === "format"}>{copy.formatMode}</button
      >
      <button
        class:list={["mode-button", { "is-active": initialMode === "minify" }]}
        type="button"
        data-mode-button="minify"
        aria-pressed={initialMode === "minify"}>{copy.minifyMode}</button
      >
    </div>
  </div>
  <div class="converter-grid">
    <section class="editor-pane">
      <div class="pane-heading">
        <label for="javascript-formatter-input">{copy.inputLabel}</label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-sample>
            {copy.loadSample}
          </button>
          <button class="text-button" type="button" data-open-file>
            <UiIcon name="folder-open" size={14} />{copy.openFile}
          </button>
          <input
            data-file
            type="file"
            accept="text/javascript,application/javascript,.js,.mjs,.cjs"
            hidden
          />
          <button class="text-button" type="button" data-clear>
            <UiIcon name="x" size={14} />{commonCopy.clear}
          </button>
        </div>
      </div>
      <textarea
        id="javascript-formatter-input"
        data-input
        dir="ltr"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder={copy.inputPlaceholder}></textarea>
    </section>
    <section class="editor-pane output-pane">
      <div class="pane-heading">
        <label for="javascript-formatter-output">{copy.outputLabel}</label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-copy disabled>
            <UiIcon name="copy" size={14} />{commonCopy.copy}
          </button>
          <button class="text-button" type="button" data-download disabled>
            <UiIcon name="download" size={14} />{commonCopy.download}
          </button>
        </div>
      </div>
      <textarea
        id="javascript-formatter-output"
        data-output
        dir="ltr"
        readonly
        spellcheck="false"
        placeholder={copy.outputPlaceholder}></textarea>
      <p class="javascript-stale-notice" data-stale-notice hidden>
        {copy.outdated}
      </p>
    </section>
  </div>
  <ConverterStatus status={commonCopy.ready}>
    <button
      class="secondary-button formatter-manual-run"
      type="button"
      data-manual-run
      aria-keyshortcuts="Control+Enter Meta+Enter"
      hidden
      >{initialMode === "format" ? copy.runFormat : copy.runMinify}</button
    >
  </ConverterStatus>
  <FormatterOptions label={copy.optionsLabel}>
    <div
      class="formatter-options-grid"
      data-format-options
      hidden={initialMode !== "format"}
    >
      <div class="formatter-option-field">
        <label for="javascript-indent">{copy.indentationLabel}</label>
        <select
          id="javascript-indent"
          data-indent
          disabled={initialMode !== "format"}
        >
          <option value="2">{copy.twoSpaces}</option>
          <option value="4">{copy.fourSpaces}</option>
          <option value="tab">{copy.tabs}</option>
        </select>
      </div>
      <div class="formatter-option-field">
        <Tooltip
          id="javascript-print-width-help"
          triggerLabel={help.triggerLabel}
          variant="label"
          mobileAlign="end"
        >
          <label slot="target" for="javascript-print-width"
            >{copy.printWidthLabel}</label
          >
          {help.formatter.printWidth}
        </Tooltip>
        <input
          id="javascript-print-width"
          data-print-width
          type="number"
          min="40"
          max="240"
          value="80"
          disabled={initialMode !== "format"}
        />
      </div>
      <div class="formatter-check-row">
        <input
          id="javascript-semicolons"
          data-semi
          type="checkbox"
          checked
          disabled={initialMode !== "format"}
        />
        <Tooltip
          id="javascript-semicolons-help"
          triggerLabel={help.triggerLabel}
          variant="label"
        >
          <label slot="target" for="javascript-semicolons"
            >{copy.semicolonsLabel}</label
          >
          {help.formatter.semicolons}
        </Tooltip>
      </div>
      <div class="formatter-check-row">
        <input
          id="javascript-single-quotes"
          data-single-quote
          type="checkbox"
          disabled={initialMode !== "format"}
        />
        <Tooltip
          id="javascript-single-quotes-help"
          triggerLabel={help.triggerLabel}
          variant="label"
          mobileAlign="end"
        >
          <label slot="target" for="javascript-single-quotes"
            >{copy.singleQuoteLabel}</label
          >
          {help.formatter.singleQuotes}
        </Tooltip>
      </div>
    </div>
    <div
      class="formatter-options-grid"
      data-minify-options
      hidden={initialMode !== "minify"}
    >
      <div class="formatter-check-row">
        <input
          id="javascript-preserve-comments"
          data-preserve-comments
          type="checkbox"
          disabled={initialMode !== "minify"}
        />
        <Tooltip
          id="javascript-preserve-comments-help"
          triggerLabel={help.triggerLabel}
          variant="label"
          mobileAlign="end"
        >
          <label slot="target" for="javascript-preserve-comments"
            >{copy.preserveCommentsLabel}</label
          >
          {help.formatter.preserveComments}
        </Tooltip>
      </div>
    </div>
  </FormatterOptions>
  <p class="javascript-scope-notice" role="note">{copy.scopeNotice}</p>
  <div class="privacy-note">
    <span class="privacy-icon" aria-hidden="true">
      <UiIcon name="shield" size={14} />
    </span>
    <div>
      <strong>{commonCopy.localTitle}</strong><p>{commonCopy.localBody}</p>
    </div>
  </div>
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(clientCopy).replace(/</gu, "\\u003c")}
  />
</section>
<script>
  import "./client";
</script>
