---
import UiIcon from "../../components/UiIcon.astro";
import ConverterStatus from "../../components/ConverterStatus.astro";
import LocalProcessingNote from "../../components/LocalProcessingNote.astro";
import Tooltip from "../../components/Tooltip.astro";
import ToolModeSwitch from "../../components/ToolModeSwitch.astro";
import { commonToolCopy } from "../../lib/common-tool-i18n";
import { localeBundles } from "../../lib/locale-data";
import type { Locale } from "../../lib/site";
import type { Base64ClientCopy } from "./contract";
import { getBase64Copy } from "./copy";

interface Props {
  locale: Locale;
  initialMode?: "decode" | "encode";
}
const { locale, initialMode = "decode" } = Astro.props;
const t = getBase64Copy(locale);
const c = commonToolCopy[locale];
const h = localeBundles[locale].help;
const clientCopy = {
  decodeMetaTitle: t.decodeMetaTitle,
  encodeMetaTitle: t.encodeMetaTitle,
  decodeHeaderLabel: t.decodeHeaderLabel,
  encodeHeaderLabel: t.encodeHeaderLabel,
  heading: t.heading,
  subheading: t.subheading,
  encodeHeading: t.encodeHeading,
  encodeSubheading: t.encodeSubheading,
  guideTitle: t.guideTitle,
  guideIntro: t.guideIntro,
  guideSteps: t.guideSteps,
  encodeGuideTitle: t.encodeGuideTitle,
  encodeGuideIntro: t.encodeGuideIntro,
  encodeGuideSteps: t.encodeGuideSteps,
  faqs: t.faqs,
  encodeFaqs: t.encodeFaqs,
  inputLabel: t.inputLabel,
  outputLabel: t.outputLabel,
  encodeInputLabel: t.encodeInputLabel,
  encodeOutputLabel: t.encodeOutputLabel,
  decodePlaceholder: t.decodePlaceholder,
  encodePlaceholder: t.encodePlaceholder,
  runDecode: t.runDecode,
  runEncode: t.runEncode,
  ready: c.ready,
  working: c.working,
  decodeComplete: t.decodeComplete,
  encodeComplete: t.encodeComplete,
  copied: c.copied,
  copyFailed: c.copyFailed,
  fileTooLarge: t.fileTooLarge,
  detected: t.detected,
  binaryOutput: t.binaryOutput,
  executableWarning: t.executableWarning,
  hexLabel: t.hex,
  recursive: t.recursive,
  recursiveApplied: t.recursiveApplied,
  errors: t.errors,
  repairs: t.repairs,
} satisfies Base64ClientCopy;
---

<section
  class="converter"
  data-converter
  data-locale={locale}
  data-initial-mode={initialMode}
  aria-label={initialMode === "decode" ? t.heading : t.encodeHeading}
>
  <div class="converter-topbar">
    <ToolModeSwitch
      label={t.modeLabel}
      items={[
        {
          mode: "decode",
          label: t.decode,
          active: initialMode === "decode",
        },
        {
          mode: "encode",
          label: t.encode,
          active: initialMode === "encode",
        },
      ]}
    />
  </div>

  <div class="converter-grid" data-drop-zone>
    <section class="editor-pane input-pane">
      <div class="pane-heading">
        <label for="codec-input" data-input-label>{t.inputLabel}</label>
        <div class="pane-actions">
          <button class="text-button file-button" type="button" data-open-file
            ><UiIcon name="folder-open" size={14} />{t.openFile}</button
          >
          <input id="codec-file" data-file-input type="file" hidden />
          <button class="text-button" type="button" data-clear
            ><UiIcon name="x" size={14} />{c.clear}</button
          >
        </div>
      </div>
      <textarea
        id="codec-input"
        data-input
        dir={initialMode === "decode" ? "ltr" : "auto"}
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder={t.decodePlaceholder}></textarea>
      <p class="drop-hint">{t.dropHint}</p>
    </section>

    <section class="editor-pane output-pane">
      <div class="pane-heading">
        <label for="codec-output" data-output-label>{t.outputLabel}</label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-copy disabled
            ><UiIcon name="copy" size={14} />{c.copy}</button
          >
          <button class="text-button" type="button" data-download disabled
            ><UiIcon name="download" size={14} />{c.download}</button
          >
        </div>
      </div>
      <textarea
        id="codec-output"
        data-output
        dir={initialMode === "encode" ? "ltr" : "auto"}
        readonly
        spellcheck="false"
        placeholder={t.outputPlaceholder}></textarea>
      <div class="preview" data-preview hidden>
        <span>{t.imagePreview}</span>
        <img data-preview-image alt={t.imagePreview} />
      </div>
    </section>
  </div>

  <ConverterStatus status={c.ready} badges />

  <details class="options" data-options>
    <summary
      ><UiIcon name="chevron-right" class="options-chevron" /><span
        >{t.options}</span
      ></summary
    >
    <div class="options-grid">
      <div class="option-field decode-only">
        <Tooltip
          id="base64-charset-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-charset">{t.charset}</label>
          {h.base64.charset}
        </Tooltip>
        <select id="base64-charset" name="charset" data-option="charset">
          <option value="utf-8">UTF-8</option>
          <option value="euc-kr">CP949 / EUC-KR</option>
          <option value="shift_jis">Shift-JIS</option>
          <option value="gb18030">GB18030</option>
          <option value="big5">Big5</option>
          <option value="windows-1252">Windows-1252</option>
        </select>
      </div>
      <div class="option-field">
        <Tooltip
          id="base64-variant-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-variant">{t.variant}</label>
          {h.base64.variant}
        </Tooltip>
        <select id="base64-variant" name="base64-variant" data-option="variant">
          <option value="auto">{t.auto}</option>
          <option value="standard">{t.standard}</option>
          <option value="url">{t.urlSafe}</option>
        </select>
      </div>
      <div class="option-field decode-only">
        <Tooltip
          id="base64-output-view-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-output-view">{t.outputView}</label>
          {h.base64.outputView}
        </Tooltip>
        <select
          id="base64-output-view"
          name="output-view"
          data-option="outputView"
        >
          <option value="text">{t.text}</option>
          <option value="hex">{t.hex}</option>
        </select>
      </div>
      <div class="check-row decode-only">
        <input
          id="base64-strict"
          name="strict"
          type="checkbox"
          data-option="strict"
        />
        <Tooltip
          id="base64-strict-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-strict">{t.strict}</label>
          {h.base64.strict}
        </Tooltip>
      </div>
      <div class="check-row decode-only">
        <input
          id="base64-line-by-line"
          name="line-by-line"
          type="checkbox"
          data-option="lineByLine"
        />
        <Tooltip
          id="base64-line-by-line-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-line-by-line">{t.lineByLine}</label>
          {h.base64.lineByLine}
        </Tooltip>
      </div>
      <div class="check-row decode-only">
        <input
          id="base64-auto-repair"
          name="auto-repair"
          type="checkbox"
          data-option="autoRepair"
          checked
        />
        <Tooltip
          id="base64-auto-repair-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-auto-repair">{t.autoRepair}</label>
          {h.base64.autoRepair}
        </Tooltip>
      </div>
      <div class="check-row decode-only">
        <input
          id="base64-recursive"
          name="recursive"
          type="checkbox"
          data-option="recursive"
          checked
        />
        <Tooltip
          id="base64-recursive-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-recursive">{t.recursive}</label>
          {h.base64.recursive}
        </Tooltip>
      </div>
      <div class="check-row decode-only">
        <input
          id="base64-lenient-repair"
          name="lenient-repair"
          type="checkbox"
          data-option="lenientRepair"
        />
        <Tooltip
          id="base64-lenient-repair-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-lenient-repair"
            >{t.lenientRepair}</label
          >
          {h.base64.lenientRepair}
        </Tooltip>
      </div>
      <div class="check-row encode-only">
        <input
          id="base64-include-padding"
          name="include-padding"
          type="checkbox"
          data-option="includePadding"
          checked
        />
        <Tooltip
          id="base64-include-padding-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-include-padding"
            >{t.includePadding}</label
          >
          {h.base64.includePadding}
        </Tooltip>
      </div>
      <div class="check-row encode-only">
        <input
          id="base64-mime-wrap"
          name="mime-wrap"
          type="checkbox"
          data-option="mimeWrap"
        />
        <Tooltip
          id="base64-mime-wrap-help"
          triggerLabel={h.triggerLabel}
          variant="label"
        >
          <label slot="target" for="base64-mime-wrap">{t.mimeWrap}</label>
          {h.base64.mimeWrap}
        </Tooltip>
      </div>
      <div class="check-row encode-only">
        <input
          id="base64-data-uri"
          name="data-uri"
          type="checkbox"
          data-option="dataUri"
        />
        <Tooltip
          id="base64-data-uri-help"
          triggerLabel={h.triggerLabel}
          variant="label"
          mobileAlign="end"
        >
          <label slot="target" for="base64-data-uri">{t.dataUri}</label>
          {h.base64.dataUri}
        </Tooltip>
      </div>
    </div>
  </details>

  <LocalProcessingNote locale={locale} />

  <script
    is:inline
    type="application/json"
    data-tool-copy
    set:html={JSON.stringify(clientCopy)}
  />
</section>

<script>
  import "./client";
</script>
