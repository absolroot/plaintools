---
import ConverterStatus from "../../components/ConverterStatus.astro";
import Tooltip from "../../components/Tooltip.astro";
import IconButton from "../../components/IconButton.astro";
import LocalProcessingNote from "../../components/LocalProcessingNote.astro";
import ToolModeSwitch from "../../components/ToolModeSwitch.astro";
import type { ToolHelpCopy } from "../../lib/locale-data/tool-help";
import { localizedPath, type Locale } from "../../lib/site";
import type { QrGeneratorCopy } from "./contract";

interface Props {
  locale: Locale;
  copy: QrGeneratorCopy;
  help: ToolHelpCopy;
  generatorLabel: string;
  scannerLabel: string;
  textDirection?: "auto" | "ltr" | "rtl";
}

const {
  locale,
  copy,
  help,
  generatorLabel,
  scannerLabel,
  textDirection = "ltr",
} = Astro.props;
---

<section
  class="converter qr-generator"
  data-qr-generator
  aria-label={copy.accessibleLabel}
>
  <div class="converter-topbar">
    <ToolModeSwitch
      label={`${generatorLabel} / ${scannerLabel}`}
      items={[
        {
          mode: "generator",
          label: generatorLabel,
          active: true,
          href: localizedPath(locale, "qr-code-generator"),
        },
        {
          mode: "scanner",
          label: scannerLabel,
          active: false,
          href: localizedPath(locale, "qr-code-scanner"),
        },
      ]}
    />
  </div>
  <div class="qr-workspace">
    <section class="editor-pane qr-input-pane">
      <div class="pane-heading">
        <label for="qr-generator-input">{copy.inputLabel}</label>
        <IconButton variant="text" icon="x" data-clear>{copy.clear}</IconButton>
      </div>
      <textarea
        id="qr-generator-input"
        data-input
        dir={textDirection}
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder={copy.inputPlaceholder}></textarea>
    </section>

    <ConverterStatus status={copy.ready}>
      <button class="primary-button" type="button" data-generate>
        {copy.generate}
      </button>
    </ConverterStatus>

    <section class="qr-preview-pane" aria-labelledby="qr-preview-heading">
      <div class="pane-heading">
        <span id="qr-preview-heading">{copy.previewLabel}</span>
      </div>
      <div class="qr-preview" data-preview>
        <canvas data-canvas role="img" aria-label={copy.previewLabel} hidden
        ></canvas>
        <p data-preview-placeholder>{copy.previewPlaceholder}</p>
      </div>
      <div class="qr-downloads">
        <IconButton
          variant="secondary"
          icon="download"
          data-download-png
          disabled
        >
          {copy.downloadPng}
        </IconButton>
        <IconButton
          variant="secondary"
          icon="download"
          data-download-svg
          disabled
        >
          {copy.downloadSvg}
        </IconButton>
      </div>
    </section>
  </div>

  <div class="qr-options" role="group" aria-label={copy.optionsLabel}>
    <div class="qr-option">
      <Tooltip
        id="qr-error-correction-help"
        triggerLabel={help.triggerLabel}
        variant="label"
      >
        <label slot="target" for="qr-error-correction"
          >{copy.errorCorrectionLabel}</label
        >
        {help.qr.errorCorrection}
      </Tooltip>
      <select id="qr-error-correction" data-error-correction>
        {
          (["L", "M", "Q", "H"] as const).map((level) => (
            <option value={level} selected={level === "M"}>
              {copy.errorCorrectionOptions[level]}
            </option>
          ))
        }
      </select>
    </div>
    <div class="qr-option">
      <Tooltip
        id="qr-quiet-zone-help"
        triggerLabel={help.triggerLabel}
        variant="label"
        mobileAlign="end"
      >
        <label slot="target" for="qr-quiet-zone">{copy.quietZoneLabel}</label>
        {help.qr.quietZone}
      </Tooltip>
      <select id="qr-quiet-zone" data-quiet-zone>
        {
          (["0", "2", "4", "8"] as const).map((value) => (
            <option value={value} selected={value === "4"}>
              {copy.quietZoneOptions[value]}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <LocalProcessingNote locale={locale} />
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(copy).replace(/</gu, "\\u003c")}
  />
</section>

<script>
  import "./generator-client";
</script>
