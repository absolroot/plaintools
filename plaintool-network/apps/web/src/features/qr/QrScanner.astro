---
import ConverterStatus from "../../components/ConverterStatus.astro";
import IconButton from "../../components/IconButton.astro";
import UiIcon from "../../components/UiIcon.astro";
import ToolModeSwitch from "../../components/ToolModeSwitch.astro";
import { localizedPath, type Locale } from "../../lib/site";
import type { QrScannerCopy } from "./contract";

interface Props {
  locale: Locale;
  copy: QrScannerCopy;
  generatorLabel: string;
  scannerLabel: string;
  resultDirection?: "auto" | "ltr" | "rtl";
}

const {
  locale,
  copy,
  generatorLabel,
  scannerLabel,
  resultDirection = "ltr",
} = Astro.props;
---

<section
  class="converter qr-scanner"
  data-qr-scanner
  aria-label={copy.accessibleLabel}
>
  <div class="converter-topbar">
    <ToolModeSwitch
      label={`${generatorLabel} / ${scannerLabel}`}
      items={[
        {
          mode: "generator",
          label: generatorLabel,
          active: false,
          href: localizedPath(locale, "qr-code-generator"),
        },
        {
          mode: "scanner",
          label: scannerLabel,
          active: true,
          href: localizedPath(locale, "qr-code-scanner"),
        },
      ]}
    />
  </div>
  <div class="qr-scanner-workspace">
    <section class="qr-upload-pane" data-drop-zone>
      <div class="pane-heading">
        <span>{copy.uploadLabel}</span>
        <IconButton variant="text" icon="x" data-clear>{copy.clear}</IconButton>
      </div>
      <div class="qr-upload-body">
        <IconButton variant="secondary" icon="folder-open" data-open-file
          >{copy.chooseImage}</IconButton
        >
        <input
          data-file-input
          type="file"
          accept="image/png,image/jpeg,image/webp,image/gif,image/bmp"
          hidden
        />
        <div class="qr-upload-empty" data-upload-empty>
          <p>{copy.dropHint}</p>
          <small>{copy.supportedImageTypes}</small>
        </div>
        <figure class="qr-upload-preview" data-upload-preview hidden>
          <img data-preview-image alt={copy.uploadLabel} />
          <figcaption data-preview-name></figcaption>
        </figure>
      </div>
    </section>

    <section class="qr-camera-pane">
      <div class="pane-heading"><span>{copy.cameraLabel}</span></div>
      <div class="qr-camera-stage">
        <video data-video aria-label={copy.cameraLabel} playsinline muted hidden
        ></video>
        <p data-camera-hint>{copy.cameraHint}</p>
      </div>
      <div class="qr-camera-actions">
        <button class="secondary-button" type="button" data-start-camera>
          {copy.startCamera}
        </button>
        <button class="secondary-button" type="button" data-stop-camera hidden>
          {copy.stopCamera}
        </button>
      </div>
    </section>
  </div>

  <section class="editor-pane qr-scan-result">
    <div class="pane-heading">
      <label for="qr-scanner-result">{copy.resultLabel}</label>
      <div class="pane-actions">
        <span class="qr-url-badge" data-url-badge hidden
          >{copy.urlDetected}</span
        >
        <button class="text-button" type="button" data-open-url hidden disabled>
          <UiIcon name="arrow-right" size={14} />{copy.openUrl}
        </button>
        <IconButton variant="text" icon="copy" data-copy disabled
          >{copy.copy}</IconButton
        >
      </div>
    </div>
    <textarea
      id="qr-scanner-result"
      data-result
      dir={resultDirection}
      readonly
      spellcheck="false"
      placeholder={copy.resultPlaceholder}></textarea>
  </section>

  <dialog
    class="qr-url-dialog"
    data-url-dialog
    aria-labelledby="qr-url-dialog-title"
    aria-describedby="qr-url-dialog-description"
  >
    <div class="qr-url-dialog-content">
      <div class="qr-url-dialog-heading">
        <UiIcon name="shield" size={20} />
        <h2 id="qr-url-dialog-title">{copy.urlDialogTitle}</h2>
      </div>
      <p id="qr-url-dialog-description">{copy.urlDialogBody}</p>
      <div class="qr-url-destination">
        <span>{copy.urlDialogDestination}</span>
        <code data-url-destination dir="ltr"></code>
      </div>
      <div class="qr-url-dialog-actions">
        <button class="secondary-button" type="button" data-cancel-url autofocus
          >{copy.cancel}</button
        >
        <button class="primary-button" type="button" data-confirm-url>
          {copy.openUrl}
        </button>
      </div>
    </div>
  </dialog>

  <ConverterStatus status={copy.ready} />
  <canvas data-scan-canvas hidden></canvas>

  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(copy).replace(/</gu, "\\u003c")}
  />
</section>

<script>
  import "./scanner-client";
</script>
