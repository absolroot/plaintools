---
import UiIcon from "../../components/UiIcon.astro";
import { localeBundles } from "../../lib/locale-data";
import type { Locale } from "../../lib/site";
import type { RegexTesterCopy } from "./contract";
import {
  MAX_REGEX_EXPRESSION_LENGTH,
  MAX_REGEX_REPLACEMENT_LENGTH,
  MAX_REGEX_TEXT_LENGTH,
} from "./evaluate";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = localeBundles[locale].tools["regex-tester"]
  .feature as RegexTesterCopy;
---

<section
  class="regex-tester converter"
  data-regex-tester
  aria-label={localeBundles[locale].tools["regex-tester"].title}
>
  <div class="converter-topbar regex-actions">
    <span class="regex-engine-note">{t.engineLabel}</span><div
      class="regex-utility-actions"
    >
      <button class="secondary-button" type="button" data-sample
        >{t.loadSample}</button
      ><button class="secondary-button" type="button" data-clear
        ><UiIcon name="x" size={14} />{t.clear}</button
      >
    </div>
  </div>
  <div class="regex-expression-row">
    <label for="regex-expression">{t.expressionLabel}</label><div
      class="regex-expression-input"
    >
      <span aria-hidden="true">/</span><input
        id="regex-expression"
        data-expression
        dir="ltr"
        spellcheck="false"
        maxlength={MAX_REGEX_EXPRESSION_LENGTH}
        placeholder={t.expressionPlaceholder}
      /><span aria-hidden="true">/</span>
    </div><fieldset class="regex-flags" data-flags>
      <legend>{t.flagsLabel}</legend>{
        ["g", "i", "m", "s", "u", "y"].map((flag) => (
          <label title={flag}>
            <input type="checkbox" value={flag} checked={flag === "g"} />
            {flag}
          </label>
        ))
      }
    </fieldset>
  </div>
  <section class="editor-pane regex-text-pane">
    <div class="pane-heading">
      <label for="regex-text">{t.testTextLabel}</label><span data-text-count
        >0</span
      >
    </div><textarea
      id="regex-text"
      data-text
      dir="auto"
      spellcheck="false"
      maxlength={MAX_REGEX_TEXT_LENGTH}
      placeholder={t.testTextPlaceholder}></textarea>
  </section>
  <p class="visually-hidden" data-status aria-live="polite">{t.ready}</p>
  <section
    class="regex-results"
    data-results
    aria-live="polite"
    aria-label={t.resultsLabel}
  >
    <div class="regex-results-heading">
      <strong>{t.resultsLabel}</strong><span data-result-count>{t.ready}</span>
    </div><p data-empty>{t.ready}</p><ol data-match-list></ol>
  </section>
  <details class="regex-replacement-panel">
    <summary>{t.replacementLabel}</summary><div
      class="regex-replacement-content"
    >
      <label for="regex-replacement">{t.replacementPlaceholder}</label><input
        id="regex-replacement"
        class="regex-replacement-input"
        data-replacement
        dir="auto"
        spellcheck="false"
        maxlength={MAX_REGEX_REPLACEMENT_LENGTH}
        placeholder={t.replacementPlaceholder}
      /><label for="regex-replacement-output">{t.replacementOutputLabel}</label
      ><textarea
        id="regex-replacement-output"
        data-replacement-output
        dir="auto"
        readonly
        placeholder={t.replacementOutputPlaceholder}></textarea><div
        class="regex-replace-actions"
      >
        <button class="secondary-button" type="button" data-replace disabled
          >{t.replaceAction}</button
        ><button
          class="secondary-button"
          type="button"
          data-copy-result
          disabled>{t.copy}</button
        >
      </div>
    </div>
  </details>
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(t).replace(/</gu, "\\u003c")}
  />
</section>
<script>
  import "./client";
</script>
