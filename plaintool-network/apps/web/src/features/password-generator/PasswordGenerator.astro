---
import UiIcon from "../../components/UiIcon.astro";
import ConverterStatus from "../../components/ConverterStatus.astro";
import type { PasswordGeneratorProps } from "./contract";
import { createPasswordGeneratorClientCopy } from "./copy";
import "./styles.css";

const { copy, commonCopy } = Astro.props as PasswordGeneratorProps;
const clientCopy = createPasswordGeneratorClientCopy(copy, commonCopy);
---

<section
  class="converter password-generator"
  data-password-generator
  aria-label={copy.ariaLabel}
>
  <div class="password-workspace">
    <section
      class="password-result-pane"
      aria-labelledby="password-result-label"
    >
      <div class="pane-heading">
        <span id="password-result-label">{copy.resultLabel}</span>
        <div class="pane-actions">
          <button
            class="text-button"
            type="button"
            data-copy
            aria-label={copy.copyPasswordLabel}
            disabled
          >
            <UiIcon name="copy" size={14} />{commonCopy.copy}
          </button>
          <button class="text-button" type="button" data-regenerate>
            {copy.regenerate}
          </button>
        </div>
      </div>
      <input
        class="password-result"
        data-result
        type="text"
        dir="ltr"
        readonly
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder={copy.resultPlaceholder}
        aria-describedby="password-strength-summary password-generator-status"
      />
      <div class="password-result-summary" id="password-strength-summary">
        <div class="password-strength-copy">
          <span>{copy.strengthLabel}</span>
          <strong data-strength-label>—</strong>
        </div>
        <div
          class="password-strength"
          data-strength
          role="progressbar"
          aria-label={copy.strengthLabel}
          aria-valuemin="0"
          aria-valuemax="4"
          aria-valuenow="0"
        >
          <span></span><span></span><span></span><span></span>
        </div>
        <p data-strength-hint>{copy.entropyHint}</p>
        <output data-entropy></output>
      </div>
    </section>

    <section class="password-options" aria-labelledby="password-options-label">
      <div class="password-options-heading">
        <h2 id="password-options-label">{copy.optionsLabel}</h2>
      </div>
      <div class="password-length-field">
        <div class="password-length-heading">
          <label for="password-length-number">{copy.lengthLabel}</label>
          <input
            id="password-length-number"
            data-length-number
            type="number"
            inputmode="numeric"
            min="8"
            max="128"
            step="1"
            value="20"
            aria-describedby="password-generator-status"
          />
        </div>
        <input
          data-length-range
          type="range"
          min="8"
          max="128"
          step="1"
          value="20"
          aria-label={copy.lengthSliderLabel}
          aria-describedby="password-generator-status"
        />
      </div>

      <fieldset class="password-character-options" data-character-options>
        <legend>{copy.characterTypesLabel}</legend>
        <div class="password-character-grid">
          <label>
            <input type="checkbox" data-character-set="lowercase" checked />
            <span>{copy.lowercase}</span>
          </label>
          <label>
            <input type="checkbox" data-character-set="uppercase" checked />
            <span>{copy.uppercase}</span>
          </label>
          <label>
            <input type="checkbox" data-character-set="digits" checked />
            <span>{copy.digits}</span>
          </label>
          <label>
            <input type="checkbox" data-character-set="symbols" checked />
            <span>{copy.symbols}</span>
          </label>
        </div>
      </fieldset>

      <label class="password-ambiguous-option">
        <input type="checkbox" data-exclude-ambiguous checked />
        <span>
          <strong>{copy.excludeAmbiguous}</strong>
          <small>{copy.excludeAmbiguousHint}</small>
        </span>
      </label>
    </section>
  </div>

  <ConverterStatus
    status={commonCopy.ready}
    statusId="password-generator-status"
  />
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(clientCopy).replace(/</gu, "\\u003c")}
  />
</section>

<script>
  import "./client";
</script>
