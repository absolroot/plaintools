---
import UiIcon from "../../components/UiIcon.astro";
import ConverterStatus from "../../components/ConverterStatus.astro";
import Tooltip from "../../components/Tooltip.astro";
import ToolModeSwitch from "../../components/ToolModeSwitch.astro";
import type { ToolHelpCopy } from "../../lib/locale-data/tool-help";
import type { ToolCommonCopy } from "../common-copy-contract";
import type { UrlCodecCopy } from "./contract";
import "./styles.css";

interface Props {
  copy: UrlCodecCopy;
  commonCopy: ToolCommonCopy;
  help: ToolHelpCopy;
  initialMode?: "encode" | "decode";
  textDirection?: "ltr";
  encodeHref: string;
  decodeHref: string;
}

const {
  copy,
  commonCopy,
  help,
  initialMode = "encode",
  textDirection = "ltr",
  encodeHref,
  decodeHref,
} = Astro.props;
---

<section
  class="converter url-codec"
  data-url-codec
  data-mode={initialMode}
  aria-label={copy.ariaLabel}
>
  <div class="converter-topbar url-codec-topbar">
    <ToolModeSwitch
      label={copy.modeLabel}
      items={[
        {
          mode: "decode",
          label: copy.decodeMode,
          active: initialMode === "decode",
          href: decodeHref,
        },
        {
          mode: "encode",
          label: copy.encodeMode,
          active: initialMode === "encode",
          href: encodeHref,
        },
      ]}
    />
    <div class="url-inline-options">
      <div class="url-option-field">
        <Tooltip
          id="url-scope-help"
          triggerLabel={help.triggerLabel}
          variant="label"
        >
          <label slot="target" for="url-scope">{copy.scopeLabel}</label>
          {help.url.scope}
        </Tooltip>
        <select id="url-scope" data-scope>
          <option value="component">{copy.componentScope}</option>
          <option value="uri">{copy.uriScope}</option>
        </select>
      </div>
      <div class="url-check-row">
        <input id="url-form-space" type="checkbox" data-form-space />
        <Tooltip
          id="url-form-space-help"
          triggerLabel={help.triggerLabel}
          variant="label"
          mobileAlign="end"
        >
          <label slot="target" for="url-form-space">{copy.formSpaceLabel}</label
          >
          {help.url.formSpace}
        </Tooltip>
      </div>
    </div>
  </div>
  <div
    class="url-decode-options"
    data-decode-options
    hidden={initialMode !== "decode"}
  >
    <div class="url-check-row">
      <input id="url-recursive" type="checkbox" data-recursive />
      <Tooltip
        id="url-recursive-help"
        triggerLabel={help.triggerLabel}
        variant="label"
      >
        <label slot="target" for="url-recursive">{copy.recursiveLabel}</label>
        {help.url.recursive}
      </Tooltip>
    </div>
    <label class="url-pass-limit" data-pass-limit-control hidden>
      <span>{copy.passLimitLabel}</span>
      <select data-pass-limit disabled>
        {
          [2, 3, 4, 5, 10].map((value) => (
            <option value={value}>{value}</option>
          ))
        }
      </select>
    </label>
  </div>
  <div class="converter-grid">
    <section class="editor-pane">
      <div class="pane-heading">
        <label for="url-codec-input" data-input-label>
          {
            initialMode === "encode"
              ? copy.encodeInputLabel
              : copy.decodeInputLabel
          }
        </label>
        <button class="text-button" type="button" data-clear>
          <UiIcon name="x" size={14} />{commonCopy.clear}
        </button>
      </div>
      <textarea
        id="url-codec-input"
        data-input
        dir={textDirection}
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder={initialMode === "encode"
          ? copy.encodePlaceholder
          : copy.decodePlaceholder}></textarea>
    </section>
    <section class="editor-pane output-pane">
      <div class="pane-heading">
        <label for="url-codec-output" data-output-label>
          {
            initialMode === "encode"
              ? copy.encodeOutputLabel
              : copy.decodeOutputLabel
          }
        </label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-copy disabled>
            <UiIcon name="copy" size={14} />{commonCopy.copy}
          </button>
          <button class="text-button" type="button" data-download disabled>
            <UiIcon name="download" size={14} />{commonCopy.download}
          </button>
        </div>
      </div>
      <textarea
        id="url-codec-output"
        data-output
        dir={textDirection}
        readonly
        spellcheck="false"
        placeholder={copy.outputPlaceholder}></textarea>
    </section>
  </div>
  <ConverterStatus status={commonCopy.ready} badges />
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify({ feature: copy, common: commonCopy }).replace(
      /</gu,
      "\\u003c",
    )}
  />
</section>
<script>
  import "./client";
</script>
