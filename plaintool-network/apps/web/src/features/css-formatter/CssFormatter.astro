---
import UiIcon from "../../components/UiIcon.astro";
import ConverterStatus from "../../components/ConverterStatus.astro";
import Tooltip from "../../components/Tooltip.astro";
import type { ToolHelpCopy } from "../../lib/locale-data/tool-help";
import type { ToolCommonCopy } from "../common-copy-contract";
import type { CssFormatterCopy } from "./contract";
import { createCssFormatterClientCopy } from "./copy";

interface Props {
  copy: CssFormatterCopy;
  commonCopy: ToolCommonCopy;
  help: ToolHelpCopy;
}

const { copy, commonCopy, help } = Astro.props;
const clientCopy = createCssFormatterClientCopy(copy, commonCopy);
---

<section
  class="converter css-formatter"
  data-css-formatter
  aria-label={copy.ariaLabel}
>
  <div class="converter-topbar css-formatter-topbar">
    <div class="primary-actions" role="group" aria-label={copy.modeLabel}>
      <button
        class="primary-button"
        type="button"
        data-mode="format"
        aria-pressed="true"
        aria-keyshortcuts="Control+Enter Meta+Enter">{copy.format}</button
      >
    </div>
    <details class="css-options">
      <summary>{copy.optionsLabel}</summary>
      <div class="css-option-fields">
        <label>
          <span>{copy.indentationLabel}</span>
          <select data-indent>
            <option value="2">{copy.twoSpaces}</option>
            <option value="4">{copy.fourSpaces}</option>
            <option value="tab">{copy.tabs}</option>
          </select>
        </label>
        <div class="css-option-field">
          <Tooltip
            id="css-print-width-help"
            triggerLabel={help.triggerLabel}
            variant="label"
            mobileAlign="end"
          >
            <label slot="target" for="css-print-width"
              >{copy.printWidthLabel}</label
            >
            {help.formatter.printWidth}
          </Tooltip>
          <input
            id="css-print-width"
            data-print-width
            type="number"
            min="40"
            max="240"
            value="80"
          />
        </div>
      </div>
    </details>
  </div>
  <div class="converter-grid">
    <section class="editor-pane">
      <div class="pane-heading">
        <label for="css-formatter-input">{copy.inputLabel}</label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-sample>
            {copy.loadSample}
          </button>
          <button class="text-button" type="button" data-open-file>
            <UiIcon name="folder-open" size={14} />{copy.openFile}
          </button>
          <input data-file type="file" accept="text/css,.css" hidden />
          <button class="text-button" type="button" data-clear>
            <UiIcon name="x" size={14} />{commonCopy.clear}
          </button>
        </div>
      </div>
      <textarea
        id="css-formatter-input"
        data-input
        dir="ltr"
        spellcheck="false"
        placeholder={copy.inputPlaceholder}></textarea>
    </section>
    <section class="editor-pane output-pane">
      <div class="pane-heading">
        <label for="css-formatter-output">{copy.outputLabel}</label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-copy disabled>
            <UiIcon name="copy" size={14} />{commonCopy.copy}
          </button>
          <button class="text-button" type="button" data-download disabled>
            <UiIcon name="download" size={14} />{commonCopy.download}
          </button>
        </div>
      </div>
      <textarea
        id="css-formatter-output"
        data-output
        dir="ltr"
        readonly
        spellcheck="false"
        placeholder={copy.outputPlaceholder}></textarea>
      <p class="css-stale-notice" data-stale-notice hidden>
        {copy.outdated}
      </p>
    </section>
  </div>
  <p class="css-scope-notice" role="note">{copy.scopeNotice}</p>
  <ConverterStatus status={commonCopy.ready} />
  <div class="privacy-note">
    <span class="privacy-icon" aria-hidden="true">
      <UiIcon name="shield" size={14} />
    </span>
    <div>
      <strong>{commonCopy.localTitle}</strong><p>{commonCopy.localBody}</p>
    </div>
  </div>
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(clientCopy).replace(/</gu, "\\u003c")}
  />
</section>
<script>
  import "./client";
</script>
