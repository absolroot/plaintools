---
import ConverterStatus from "../../components/ConverterStatus.astro";
import FormatterOptions from "../../components/FormatterOptions.astro";
import FormatterWorkspace from "../../components/FormatterWorkspace.astro";
import Tooltip from "../../components/Tooltip.astro";
import { localeBundles } from "../../lib/locale-data";
import { previewCopy } from "../../lib/tool-i18n";
import { toolExamples } from "../../lib/tool-examples";
import type { Locale } from "../../lib/site";
import type { JsonClientCopy } from "./contract";
import { jsonCopy } from "./copy";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = previewCopy[locale].common;
const t = jsonCopy[locale];
const examples = toolExamples[locale];
const formatterUi = localeBundles[locale].tools["html-formatter"].feature;
const clientCopy = {
  ready: c.ready,
  working: c.working,
  copied: c.copied,
  copyFailed: c.copyFailed,
  processingFailed: c.processingFailed,
  tooLarge: t.tooLarge,
  manualRequired: t.manualRequired,
  valid: t.valid,
  invalidAt: t.invalidAt,
  duplicate: t.duplicate,
  bom: t.bom,
  errorMessages: t.errorMessages,
} satisfies JsonClientCopy;
---

<section
  class="converter json-formatter"
  data-json-tool
  data-sample-input={'{"name":"AbsolTools","items":[1,2,3]}'}
  aria-label={t.title}
>
  <div class="converter-topbar json-formatter-topbar">
    <div class="mode-switch json-mode-switch" role="group" aria-label={t.title}>
      <button
        class="mode-button is-active"
        type="button"
        data-action="format"
        aria-pressed="true"
        aria-keyshortcuts="Control+Enter Meta+Enter">{t.format}</button
      >
      <Tooltip id="json-validate-help" triggerLabel={t.validateHelpLabel}>
        <button
          slot="target"
          class="mode-button"
          type="button"
          data-action="validate"
          aria-pressed="false"
          aria-describedby="json-validate-help">{t.validate}</button
        >
        {t.validateHelp}
      </Tooltip>
      <Tooltip
        id="json-minify-help"
        triggerLabel={t.minifyHelpLabel}
        mobileAlign="end"
      >
        <button
          slot="target"
          class="mode-button"
          type="button"
          data-action="minify"
          aria-pressed="false"
          aria-describedby="json-minify-help">{t.minify}</button
        >
        {t.minifyHelp}
      </Tooltip>
    </div>
  </div>
  <FormatterWorkspace
    inputId="json-input"
    outputId="json-output"
    inputLabel={t.inputLabel}
    outputLabel={t.outputLabel}
    inputPlaceholder={examples.jsonInput}
    outputPlaceholder={t.outputPlaceholder}
    loadSample={formatterUi.loadSample}
    openFile={t.openFile}
    clear={c.clear}
    copy={c.copy}
    download={c.download}
    fileAccept="application/json,.json"
    staleNotice={formatterUi.outdated}
  />
  <ConverterStatus status={c.ready} badges />
  <FormatterOptions label={formatterUi.optionsLabel}>
    <div class="formatter-options-grid">
      <div class="formatter-option-field">
        <label for="json-indent">{t.indent}</label>
        <select id="json-indent" name="indent" data-indent>
          <option value="2">{t.twoSpaces}</option>
          <option value="4">{t.fourSpaces}</option>
          <option value="tab">{t.tabs}</option>
        </select>
      </div>
    </div>
  </FormatterOptions>
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(clientCopy)}
  />
</section>
<script>
  import "./client";
</script>
