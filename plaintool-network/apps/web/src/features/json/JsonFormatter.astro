---
import UiIcon from "../../components/UiIcon.astro";
import ConverterStatus from "../../components/ConverterStatus.astro";
import FormatterOptions from "../../components/FormatterOptions.astro";
import LocalProcessingNote from "../../components/LocalProcessingNote.astro";
import ToolModeSwitch from "../../components/ToolModeSwitch.astro";
import { localeBundles } from "../../lib/locale-data";
import { previewCopy } from "../../lib/tool-i18n";
import { toolExamples } from "../../lib/tool-examples";
import type { Locale } from "../../lib/site";
import type { JsonClientCopy } from "./contract";
import { jsonCopy } from "./copy";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = previewCopy[locale].common;
const t = jsonCopy[locale];
const siteCopy = localeBundles[locale].site;
const examples = toolExamples[locale];
const clientCopy = {
  ready: c.ready,
  working: c.working,
  copied: c.copied,
  copyFailed: c.copyFailed,
  processingFailed: c.processingFailed,
  tooLarge: t.tooLarge,
  manualRequired: t.manualRequired,
  valid: t.valid,
  invalidAt: t.invalidAt,
  duplicate: t.duplicate,
  bom: t.bom,
  errorMessages: t.errorMessages,
} satisfies JsonClientCopy;
---

<section class="converter" data-json-tool aria-label={t.title}>
  <div class="converter-topbar">
    <ToolModeSwitch
      label={t.title}
      items={[
        { mode: "format", label: t.format, active: true },
        { mode: "validate", label: t.validate, active: false },
        { mode: "minify", label: t.minify, active: false },
      ]}
    />
  </div>
  <div class="converter-grid">
    <section class="editor-pane">
      <div class="pane-heading">
        <label for="json-input">{t.inputLabel}</label><div class="pane-actions">
          <button class="text-button" type="button" data-open-file
            ><UiIcon name="folder-open" size={14} />{t.openFile}</button
          ><input
            id="json-file"
            data-file
            type="file"
            accept="application/json,.json"
            hidden
          /><button class="text-button" type="button" data-clear
            ><UiIcon name="x" size={14} />{c.clear}</button
          >
        </div>
      </div><textarea
        id="json-input"
        data-input
        dir="ltr"
        spellcheck="false"
        placeholder={examples.jsonInput}></textarea>
    </section><section class="editor-pane output-pane">
      <div class="pane-heading">
        <label for="json-output">{t.outputLabel}</label><div
          class="pane-actions"
        >
          <button class="text-button" type="button" data-copy disabled
            ><UiIcon name="copy" size={14} />{c.copy}</button
          ><button class="text-button" type="button" data-download disabled
            ><UiIcon name="download" size={14} />{c.download}</button
          >
        </div>
      </div><textarea
        id="json-output"
        data-output
        dir="ltr"
        readonly
        spellcheck="false"
        placeholder={t.outputPlaceholder}></textarea>
    </section>
  </div>
  <ConverterStatus status={c.ready} badges>
    <button
      class="secondary-button formatter-manual-run"
      type="button"
      data-manual-run
      aria-keyshortcuts="Control+Enter Meta+Enter"
      hidden>{t.format}</button
    >
  </ConverterStatus>
  <FormatterOptions label={siteCopy.options}>
    <div class="formatter-options-grid">
      <div class="formatter-option-field">
        <label for="json-indent">{t.indent}</label>
        <select id="json-indent" name="indent" data-indent>
          <option value="2">{t.twoSpaces}</option>
          <option value="4">{t.fourSpaces}</option>
          <option value="tab">{t.tabs}</option>
        </select>
      </div>
    </div>
  </FormatterOptions>
  <LocalProcessingNote locale={locale} />
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(clientCopy)}
  />
</section>
<script>
  import "./client";
</script>
