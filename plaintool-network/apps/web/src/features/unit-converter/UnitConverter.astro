---
import ConverterStatus from "../../components/ConverterStatus.astro";
import UiIcon from "../../components/UiIcon.astro";
import {
  unitCategories,
  unitsFor,
  type UnitCategory,
} from "@plaintool/unit-converter-core";
import type { UnitConverterCopy } from "./contract";

interface Props {
  copy: UnitConverterCopy;
}
const { copy } = Astro.props;
const initialCategory: UnitCategory = "length";
const initialUnits = unitsFor(initialCategory);
---

<section
  class="unit-converter converter"
  data-unit-converter
  aria-label={copy.ariaLabel}
>
  <div class="unit-category-bar">
    <label class="unit-category-field">
      <span>{copy.category}</span>
      <select data-category aria-label={copy.category}>
        {
          unitCategories.map((category) => (
            <option value={category} selected={category === initialCategory}>
              {copy.categories[category]}
            </option>
          ))
        }
      </select>
    </label>
  </div>
  <div class="unit-workspace">
    <label class="unit-value-field">
      <span>{copy.from}</span>
      <input
        data-value
        inputmode="decimal"
        autocomplete="off"
        dir="ltr"
        value="1"
        aria-describedby="unit-converter-status"
      />
    </label>
    <label class="unit-select-field">
      <span>{copy.from}</span>
      <select data-from aria-describedby="unit-converter-status">
        {
          initialUnits.map((unit) => (
            <option value={unit.id} selected={unit.id === "meter"}>
              {copy.unitNames[unit.id] ?? unit.name} ({unit.symbol})
            </option>
          ))
        }
      </select>
    </label>
    <button
      class="unit-swap"
      type="button"
      data-swap
      aria-label={copy.swap}
      title={copy.swap}><UiIcon name="swap" size={16} /></button
    >
    <label class="unit-select-field">
      <span>{copy.to}</span>
      <select data-to aria-describedby="unit-converter-status">
        {
          initialUnits.map((unit) => (
            <option value={unit.id} selected={unit.id === "foot"}>
              {copy.unitNames[unit.id] ?? unit.name} ({unit.symbol})
            </option>
          ))
        }
      </select>
    </label>
    <div class="unit-result-field">
      <span>{copy.result}</span>
      <output data-result dir="ltr" aria-live="polite"></output>
      <small data-result-unit></small>
    </div>
  </div>
  <ConverterStatus status={copy.ready} statusId="unit-converter-status" />
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(copy).replace(/</gu, "\\u003c")}
  />
</section>
<script>
  import "./client";
</script>
