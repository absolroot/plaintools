---
import UiIcon from "../../components/UiIcon.astro";
import ConverterStatus from "../../components/ConverterStatus.astro";
import { localizedPath } from "../../lib/site";
import type { DateCalculatorMode, DateCalculatorProps } from "./contract";
import { createDateCalculatorClientCopy } from "./copy";

const { locale, copy, commonCopy, initialMode } =
  Astro.props as DateCalculatorProps;
const clientCopy = createDateCalculatorClientCopy(copy, commonCopy);
const modeRoutes = [
  {
    mode: "difference",
    page: "dday-calculator",
    label: copy.differenceMode,
  },
  { mode: "math", page: "date-calculator", label: copy.dateMathMode },
  { mode: "age", page: "age-calculator", label: copy.ageMode },
] as const satisfies readonly {
  mode: DateCalculatorMode;
  page: "date-calculator" | "dday-calculator" | "age-calculator";
  label: string;
}[];
const amountFields = [
  ["years", copy.years],
  ["months", copy.months],
  ["weeks", copy.weeks],
  ["days", copy.days],
] as const;
---

<section
  class="converter date-calculator"
  data-date-calculator
  data-mode={initialMode}
  data-locale={locale}
  aria-label={copy.ariaLabel}
>
  <div class="converter-topbar">
    <div class="mode-switch" role="group" aria-label={copy.ariaLabel}>
      {
        modeRoutes.map(({ mode, page, label }) => (
          <a
            class:list={["mode-button", { "is-active": initialMode === mode }]}
            href={localizedPath(locale, page)}
            data-mode-button={mode}
            aria-current={initialMode === mode ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="date-calculator-workspace">
    <div
      class="date-mode-panel"
      data-mode-panel="difference"
      hidden={initialMode !== "difference"}
    >
      <div class="date-field-grid">
        <label class="date-field">
          <span>{copy.startDate}</span>
          <span class="date-input-row">
            <input
              type="date"
              data-field="start"
              aria-describedby="date-calculator-status"
            />
            <button
              class="secondary-button"
              type="button"
              data-today-for="start"
            >
              {copy.today}
            </button>
          </span>
        </label>
        <label class="date-field">
          <span>{copy.endDate}</span>
          <span class="date-input-row">
            <input
              type="date"
              data-field="end"
              aria-describedby="date-calculator-status"
            />
            <button class="secondary-button" type="button" data-today-for="end">
              {copy.today}
            </button>
          </span>
        </label>
      </div>
      <label class="date-option">
        <input type="checkbox" data-field="includeEnd" />
        <span
          ><strong>{copy.includeEndDate}</strong><small
            >{copy.includeEndHint}</small
          ></span
        >
      </label>
    </div>

    <div
      class="date-mode-panel"
      data-mode-panel="math"
      hidden={initialMode !== "math"}
    >
      <div class="date-field-grid date-math-main-fields">
        <label class="date-field">
          <span>{copy.baseDate}</span>
          <span class="date-input-row">
            <input
              type="date"
              data-field="base"
              aria-describedby="date-calculator-status"
            />
            <button
              class="secondary-button"
              type="button"
              data-today-for="base"
            >
              {copy.today}
            </button>
          </span>
        </label>
        <label class="date-field">
          <span>{copy.operation}</span>
          <select
            data-field="operation"
            aria-describedby="date-calculator-status"
          >
            <option value="add">{copy.add}</option>
            <option value="subtract">{copy.subtract}</option>
          </select>
        </label>
      </div>
      <div class="date-amount-grid">
        {
          amountFields.map(([key, label]) => (
            <label class="date-field">
              <span>{label}</span>
              <input
                type="number"
                inputmode="numeric"
                min="0"
                max="100000"
                step="1"
                value={key === "days" ? "30" : "0"}
                data-amount={key}
                aria-describedby="date-calculator-status"
              />
            </label>
          ))
        }
      </div>
      <p class="date-calculator-note">{copy.monthEndNote}</p>
    </div>

    <div
      class="date-mode-panel"
      data-mode-panel="age"
      hidden={initialMode !== "age"}
    >
      <div class="date-field-grid">
        <label class="date-field">
          <span>{copy.birthDate}</span>
          <input
            type="date"
            data-field="birth"
            aria-describedby="date-calculator-status"
          />
        </label>
        <label class="date-field">
          <span>{copy.referenceDate}</span>
          <span class="date-input-row">
            <input
              type="date"
              data-field="reference"
              aria-describedby="date-calculator-status"
            />
            <button
              class="secondary-button"
              type="button"
              data-today-for="reference"
            >
              {copy.today}
            </button>
          </span>
        </label>
      </div>
      <p class="date-calculator-note">{copy.calendarNote}</p>
    </div>

    <div class="date-calculator-actions">
      <button class="primary-button" type="button" data-calculate
        >{copy.calculate}</button
      >
      <button class="secondary-button" type="button" data-clear>
        <UiIcon name="x" size={14} />{commonCopy.clear}
      </button>
    </div>
  </div>

  <section class="date-calculator-results" data-results hidden>
    <div class="date-result-heading">
      <h2>{copy.resultTitle}</h2>
      <button class="text-button" type="button" data-copy disabled>
        <UiIcon name="copy" size={14} />{commonCopy.copy}
      </button>
    </div>
    <dl class="date-result-grid" data-result-panel="difference">
      <div><dt>{copy.totalDays}</dt><dd data-result="totalDays"></dd></div>
      <div>
        <dt>{copy.calendarDifference}</dt><dd data-result="calendarDifference">
        </dd>
      </div>
      <div>
        <dt>{copy.weeksAndDays}</dt><dd data-result="weeksAndDays"></dd>
      </div>
      <div><dt>{copy.dDay}</dt><dd data-result="dDay" dir="ltr"></dd></div>
    </dl>
    <dl class="date-result-grid" data-result-panel="math" hidden>
      <div class="date-result-wide">
        <dt>{copy.resultingDate}</dt><dd data-result="resultingDate"></dd>
      </div>
    </dl>
    <dl class="date-result-grid" data-result-panel="age" hidden>
      <div><dt>{copy.fullAge}</dt><dd data-result="fullAge"></dd></div>
      <div><dt>{copy.exactAge}</dt><dd data-result="exactAge"></dd></div>
      <div><dt>{copy.livedDays}</dt><dd data-result="livedDays"></dd></div>
      <div>
        <dt>{copy.nextBirthday}</dt><dd data-result="nextBirthday"></dd>
      </div>
    </dl>
  </section>

  <ConverterStatus
    status={commonCopy.ready}
    statusId="date-calculator-status"
  />
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(clientCopy).replace(/</gu, "\\u003c")}
  />
</section>
<script>
  import "./client";
</script>
