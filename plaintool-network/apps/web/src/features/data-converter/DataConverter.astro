---
import ConverterStatus from "../../components/ConverterStatus.astro";
import Tooltip from "../../components/Tooltip.astro";
import ToolModeSwitch from "../../components/ToolModeSwitch.astro";
import UiIcon from "../../components/UiIcon.astro";
import type { DataConversionMode } from "@plaintool/data-conversion-core";
import { localizedPath, type Locale } from "../../lib/site";
import type { ToolHelpCopy } from "../../lib/locale-data/tool-help";
import type { DataConverterCopy } from "./contract";

interface Props {
  locale: Locale;
  mode: DataConversionMode;
  modeLabels: Record<DataConversionMode, string>;
  copy: DataConverterCopy;
  help: ToolHelpCopy;
  textDirection?: "ltr";
}

const {
  locale,
  mode,
  modeLabels,
  copy,
  help,
  textDirection = "ltr",
} = Astro.props;
const modePairs: Record<
  DataConversionMode,
  readonly [DataConversionMode, DataConversionMode]
> = {
  "csv-to-markdown": ["csv-to-markdown", "markdown-to-csv"],
  "markdown-to-csv": ["csv-to-markdown", "markdown-to-csv"],
  "json-to-csv": ["json-to-csv", "csv-to-json"],
  "csv-to-json": ["json-to-csv", "csv-to-json"],
  "html-to-markdown": ["html-to-markdown", "markdown-to-html"],
  "markdown-to-html": ["html-to-markdown", "markdown-to-html"],
};
const csvInput = mode === "csv-to-markdown" || mode === "csv-to-json";
const csvOutput = mode === "markdown-to-csv" || mode === "json-to-csv";
const accepts = csvInput
  ? ".csv,text/csv,text/plain"
  : mode === "json-to-csv"
    ? ".json,application/json,text/plain"
    : mode === "html-to-markdown"
      ? ".html,.htm,text/html,text/plain"
      : ".md,.markdown,text/markdown,text/plain";
---

<section
  class="converter data-converter"
  data-data-converter
  data-mode={mode}
  aria-label={copy.ariaLabel}
>
  <div class="converter-topbar">
    <ToolModeSwitch
      label={copy.ariaLabel}
      items={modePairs[mode].map((targetMode) => ({
        mode: targetMode,
        label: modeLabels[targetMode],
        active: targetMode === mode,
        href: localizedPath(locale, targetMode),
      }))}
    />
  </div>
  {
    (csvInput || csvOutput) && (
      <div class="converter-topbar data-options">
        {(csvInput || csvOutput) && (
          <div class="data-option">
            <Tooltip
              id={`${mode}-delimiter-help`}
              triggerLabel={help.triggerLabel}
              variant="label"
            >
              <label slot="target" for={`${mode}-delimiter`}>
                {copy.delimiterLabel}
              </label>
              {help.data.delimiter}
            </Tooltip>
            <select id={`${mode}-delimiter`} data-delimiter>
              {csvInput && <option value="auto">{copy.autoDelimiter}</option>}
              <option value=",">{copy.commaDelimiter}</option>
              <option value=";">{copy.semicolonDelimiter}</option>
              <option value="tab">{copy.tabDelimiter}</option>
              <option value="|">{copy.pipeDelimiter}</option>
            </select>
          </div>
        )}
        {mode === "csv-to-markdown" && (
          <div class="data-check">
            <input
              id="csv-first-row-header"
              type="checkbox"
              data-first-row-header
              checked
            />
            <Tooltip
              id="csv-first-row-header-help"
              triggerLabel={help.triggerLabel}
              variant="label"
              mobileAlign="end"
            >
              <label slot="target" for="csv-first-row-header">
                {copy.firstRowHeader}
              </label>
              {help.data.firstRowHeader}
            </Tooltip>
          </div>
        )}
        {mode === "csv-to-json" && (
          <label class="data-check">
            <input type="checkbox" data-pretty-json checked />
            <span>{copy.prettyJson}</span>
          </label>
        )}
      </div>
    )
  }

  <div class="converter-grid" data-drop-zone>
    <section class="editor-pane input-pane">
      <div class="pane-heading">
        <label for={`${mode}-input`}>{copy.inputLabel}</label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-open-file>
            <UiIcon name="folder-open" size={14} />{copy.openFile}
          </button>
          <input data-file type="file" accept={accepts} hidden />
          <button class="text-button" type="button" data-clear>
            <UiIcon name="x" size={14} />{copy.clear}
          </button>
        </div>
      </div>
      <textarea
        id={`${mode}-input`}
        data-input
        dir={textDirection}
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder={copy.inputPlaceholder}></textarea>
      <p class="drop-hint">{copy.dropHint}</p>
    </section>

    <ConverterStatus status={copy.ready}>
      <button class="primary-button" type="button" data-run
        >{copy.convert}</button
      >
    </ConverterStatus>

    <section class="editor-pane output-pane">
      <div class="pane-heading">
        <label for={`${mode}-output`}>{copy.outputLabel}</label>
        <div class="pane-actions">
          <button class="text-button" type="button" data-copy disabled>
            <UiIcon name="copy" size={14} />{copy.copy}
          </button>
          <button class="text-button" type="button" data-download disabled>
            <UiIcon name="download" size={14} />{copy.download}
          </button>
        </div>
      </div>
      <textarea
        id={`${mode}-output`}
        data-output
        dir={textDirection}
        readonly
        spellcheck="false"
        placeholder={copy.outputPlaceholder}></textarea>
    </section>
  </div>


  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(copy).replace(/</gu, "\\u003c")}
  />
</section>

<script>
  import "./client";
</script>
