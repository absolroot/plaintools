---
import ConverterStatus from "../../components/ConverterStatus.astro";
import UiIcon from "../../components/UiIcon.astro";
import { createTimeZoneConverterClientCopy } from "./copy";
import type { TimeZoneConverterProps } from "./contract";

const { locale, copy, commonCopy, popularZones } =
  Astro.props as TimeZoneConverterProps;
const clientCopy = createTimeZoneConverterClientCopy(copy, commonCopy);
const worldClockZones = new Set([
  "Asia/Seoul",
  "Asia/Tokyo",
  "Asia/Singapore",
  "Europe/London",
  "America/New_York",
  "Australia/Sydney",
]);
---

<section
  class="converter time-zone-converter"
  data-time-zone-converter
  data-locale={locale}
  aria-label={copy.ariaLabel}
>
  <section class="time-zone-input-surface" aria-label={copy.ariaLabel}>
    <div class="time-zone-date-row">
      <label class="time-zone-field time-zone-date-field">
        <span>{copy.sourceTime}</span>
        <input
          type="datetime-local"
          step="60"
          data-source-time
          dir="ltr"
          aria-describedby="time-zone-source-hint time-zone-status"
        />
        <small id="time-zone-source-hint">{copy.sourceTimeHint}</small>
      </label>

      <div class="time-zone-now-field">
        <button class="secondary-button" type="button" data-now>
          {copy.now}
        </button>
      </div>

      <div class="time-zone-format-field">
        <span>{copy.hourFormat}</span>
        <div
          class="time-zone-format-switch"
          role="group"
          aria-label={copy.hourFormat}
        >
          <button type="button" data-hour-format="12">{copy.hour12}</button>
          <button type="button" data-hour-format="24">{copy.hour24}</button>
        </div>
      </div>
    </div>

    <div class="time-zone-zone-row">
      <label class="time-zone-field time-zone-source-field">
        <span>{copy.sourceZone}</span>
        <select data-source-zone dir="ltr" aria-describedby="time-zone-status">
          <option value="UTC">UTC</option>
          {
            popularZones.map(({ value, label }) => (
              <option
                value={value}
                data-world-clock-zone={
                  worldClockZones.has(value) ? true : undefined
                }
              >
                {label}
              </option>
            ))
          }
        </select>
      </label>

      <button
        class="time-zone-swap-button"
        type="button"
        data-swap-zones
        aria-label={copy.convert}
        title={copy.convert}
      >
        <UiIcon name="swap" size={18} />
      </button>

      <label class="time-zone-field time-zone-target-field">
        <span>{copy.addZone}</span>
        <select data-target-zone dir="ltr" aria-describedby="time-zone-status">
          <option value="UTC">UTC</option>
          {
            popularZones.map(({ value, label }) => (
              <option value={value}>{label}</option>
            ))
          }
        </select>
      </label>
    </div>

    <div class="time-zone-source-actions">
      <button class="primary-button" type="button" data-convert>
        {copy.convert}
      </button>
    </div>
  </section>

  <section class="time-zone-result" data-conversion-result hidden>
    <div class="time-zone-result-label">
      <span>{copy.converted}</span>
      <strong data-conversion-zone dir="ltr"></strong>
    </div>
    <div class="time-zone-result-value">
      <strong data-conversion-time dir="ltr"></strong>
      <span data-conversion-date></span>
    </div>
    <div class="time-zone-result-meta">
      <strong data-conversion-offset dir="ltr"></strong>
      <span data-conversion-difference></span>
    </div>
  </section>

  <section class="world-clock-surface" aria-labelledby="world-clock-heading">
    <div class="world-clock-heading">
      <h2 id="world-clock-heading">{copy.worldClock}</h2>
      <span
        class="world-clock-live"
        data-live-indicator
        data-live-label={copy.live}
        data-converted-label={copy.converted}
      >
        <span class="world-clock-dot" aria-hidden="true"></span><span
          data-clock-mode-label>{copy.live}</span
        >
      </span>
    </div>

    <div class="world-clock-list" data-world-clock-list role="list"></div>

    <template data-zone-row-template>
      <article class="world-clock-row" role="listitem">
        <div class="world-clock-place">
          <strong data-zone-label></strong>
          <span data-zone-id dir="ltr"></span>
        </div>
        <div class="world-clock-time">
          <strong data-zone-time dir="ltr"></strong>
          <span data-zone-offset dir="ltr"></span>
        </div>
        <div class="world-clock-date">
          <strong data-zone-date></strong>
        </div>
      </article>
    </template>
  </section>

  <ConverterStatus status={commonCopy.ready} statusId="time-zone-status" />
  <script
    is:inline
    type="application/json"
    data-client-copy
    set:html={JSON.stringify(clientCopy).replace(/</gu, "\\u003c")}
  />
</section>

<script>
  import "./client";
</script>
