---
import PreviewToolPage from "../../components/PreviewToolPage.astro";
import type { DataConversionMode } from "@plaintool/data-conversion-core";
import AiTextCleaner from "../ai-text-cleaner/AiTextCleaner.astro";
import aiTextCleanerStylesheet from "../ai-text-cleaner/styles.css?url";
import DataConverter from "../data-converter/DataConverter.astro";
import dataConverterStylesheet from "../data-converter/styles.css?url";
import HashGenerator from "../hash-generator/HashGenerator.astro";
import JwtDecoder from "../jwt-decoder/JwtDecoder.astro";
import QrGenerator from "../qr/QrGenerator.astro";
import QrScanner from "../qr/QrScanner.astro";
import qrStylesheet from "../qr/styles.css?url";
import UrlCodec from "../url-codec/UrlCodec.astro";
import HtmlFormatter from "../html-formatter/HtmlFormatter.astro";
import htmlFormatterStylesheet from "../html-formatter/styles.css?url";
import CssFormatter from "../css-formatter/CssFormatter.astro";
import cssFormatterStylesheet from "../css-formatter/styles.css?url";
import JavaScriptFormatter from "../javascript-formatter/JavaScriptFormatter.astro";
import SqlFormatter from "../sql-formatter/SqlFormatter.astro";
import sqlFormatterStylesheet from "../sql-formatter/styles.css?url";
import IpSubnetCalculator from "../ip-subnet/IpSubnetCalculator.astro";
import BackgroundRemover from "../background-remover/BackgroundRemover.astro";
import backgroundRemoverStylesheet from "../background-remover/styles.css?url";
import ImageUpscaler from "../image-upscaler/ImageUpscaler.astro";
import imageUpscalerStylesheet from "../image-upscaler/styles.css?url";
import DateCalculator from "../date-calculator/DateCalculator.astro";
import dateCalculatorStylesheet from "../date-calculator/styles.css?url";
import UuidGenerator from "../uuid-generator/UuidGenerator.astro";
import type { DateCalculatorMode } from "../date-calculator/contract";
import TimeZoneConverter from "../time-zone-converter/TimeZoneConverter.astro";
import timeZoneConverterStylesheet from "../time-zone-converter/styles.css?url";
import MathCalculator from "../math-calculator/MathCalculator.astro";
import mathCalculatorStylesheet from "../math-calculator/styles.css?url";
import type { MathCalculatorMode } from "../math-calculator/contract";
import PercentageCalculator from "../percentage-calculator/PercentageCalculator.astro";
import percentageCalculatorStylesheet from "../percentage-calculator/styles.css?url";
import BmiCalculator from "../bmi-calculator/BmiCalculator.astro";
import bmiCalculatorStylesheet from "../bmi-calculator/styles.css?url";
import { localeBundles, localeMetadata } from "../../lib/locale-data";
import type { NewToolId } from "../../lib/locale-data/bundle";
import { localizedPath, type Locale } from "../../lib/site";

interface Props {
  locale: Locale;
  page: NewToolId;
}

const { locale, page } = Astro.props;
const bundle = localeBundles[locale];
const content = bundle.tools[page];
const technicalDirection = localeMetadata[locale].technicalDirection;
const featureStylesheets = {
  "ai-watermark-remover": aiTextCleanerStylesheet,
  "url-encode": undefined,
  "url-decode": undefined,
  "hash-generator": undefined,
  "jwt-decoder": undefined,
  "qr-code-generator": qrStylesheet,
  "qr-code-scanner": qrStylesheet,
  "background-remover": backgroundRemoverStylesheet,
  "image-upscaler": imageUpscalerStylesheet,
  "csv-to-markdown": dataConverterStylesheet,
  "markdown-to-csv": dataConverterStylesheet,
  "json-to-csv": dataConverterStylesheet,
  "csv-to-json": dataConverterStylesheet,
  "html-to-markdown": dataConverterStylesheet,
  "markdown-to-html": dataConverterStylesheet,
  "html-formatter": htmlFormatterStylesheet,
  "css-formatter": cssFormatterStylesheet,
  "javascript-formatter": undefined,
  "sql-formatter": sqlFormatterStylesheet,
  "ip-subnet-calculator": undefined,
  "date-calculator": dateCalculatorStylesheet,
  "dday-calculator": dateCalculatorStylesheet,
  "age-calculator": dateCalculatorStylesheet,
  "time-zone-converter": timeZoneConverterStylesheet,
  "fraction-calculator": mathCalculatorStylesheet,
  "factor-calculator": mathCalculatorStylesheet,
  "lcm-calculator": mathCalculatorStylesheet,
  "percentage-calculator": percentageCalculatorStylesheet,
  "bmi-calculator": bmiCalculatorStylesheet,
  "uuid-generator": undefined,
} as const satisfies Record<NewToolId, string | undefined>;

const dateCalculatorModes = {
  "date-calculator": "math",
  "dday-calculator": "difference",
  "age-calculator": "age",
} as const satisfies Record<string, DateCalculatorMode>;
const isDateCalculatorPage = (
  value: NewToolId,
): value is keyof typeof dateCalculatorModes => value in dateCalculatorModes;
const mathCalculatorModes = {
  "fraction-calculator": "fraction",
  "factor-calculator": "factor",
  "lcm-calculator": "lcm",
} as const satisfies Record<string, MathCalculatorMode>;
const isMathCalculatorPage = (
  value: NewToolId,
): value is keyof typeof mathCalculatorModes => value in mathCalculatorModes;
const mathModeLinks = {
  fraction: {
    href: localizedPath(locale, "fraction-calculator"),
    label: bundle.catalog["fraction-calculator"].name,
  },
  factor: {
    href: localizedPath(locale, "factor-calculator"),
    label: bundle.catalog["factor-calculator"].name,
  },
  lcm: {
    href: localizedPath(locale, "lcm-calculator"),
    label: bundle.catalog["lcm-calculator"].name,
  },
} as const;

const urlFeature =
  page === "url-encode"
    ? bundle.tools["url-encode"].feature
    : page === "url-decode"
      ? bundle.tools["url-decode"].feature
      : undefined;
const dataModes = [
  "csv-to-markdown",
  "markdown-to-csv",
  "json-to-csv",
  "csv-to-json",
  "html-to-markdown",
  "markdown-to-html",
] as const satisfies readonly DataConversionMode[];
const isDataMode = (value: NewToolId): value is DataConversionMode =>
  (dataModes as readonly NewToolId[]).includes(value);
const dataMode = isDataMode(page) ? page : undefined;
const dataFeature = dataMode ? bundle.tools[dataMode].feature : undefined;
const dataModeLabels = Object.fromEntries(
  dataModes.map((id) => [id, bundle.catalog[id].name]),
) as Record<DataConversionMode, string>;
---

<PreviewToolPage
  locale={locale}
  page={page}
  title={content.title}
  heading={content.heading}
  description={content.description}
  guideTitle={content.guideTitle}
  guideBody={content.guideBody}
  safetyTitle={content.safetyTitle}
  safetyBody={content.safetyBody}
  faqs={content.faqs}
  featureStylesheet={featureStylesheets[page]}
>
  {
    page === "ai-watermark-remover" && (
      <AiTextCleaner
        locale={locale}
        copy={bundle.tools[page].feature}
        textDirection="auto"
      />
    )
  }
  {
    urlFeature && (
      <UrlCodec
        copy={urlFeature!}
        commonCopy={bundle.common}
        help={bundle.help}
        initialMode={page === "url-encode" ? "encode" : "decode"}
        textDirection={technicalDirection}
        encodeHref={localizedPath(locale, "url-encode")}
        decodeHref={localizedPath(locale, "url-decode")}
      />
    )
  }
  {
    page === "hash-generator" && (
      <HashGenerator
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        textDirection={technicalDirection}
      />
    )
  }
  {
    page === "jwt-decoder" && (
      <JwtDecoder
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        textDirection={technicalDirection}
      />
    )
  }
  {
    page === "qr-code-generator" && (
      <QrGenerator
        locale={locale}
        copy={bundle.tools[page].feature}
        help={bundle.help}
        generatorLabel={bundle.catalog["qr-code-generator"].name}
        scannerLabel={bundle.catalog["qr-code-scanner"].name}
        textDirection="auto"
      />
    )
  }
  {
    page === "qr-code-scanner" && (
      <QrScanner
        locale={locale}
        copy={bundle.tools[page].feature}
        generatorLabel={bundle.catalog["qr-code-generator"].name}
        scannerLabel={bundle.catalog["qr-code-scanner"].name}
        resultDirection="auto"
      />
    )
  }
  {
    page === "background-remover" && (
      <BackgroundRemover locale={locale} copy={bundle.tools[page].feature} />
    )
  }
  {
    page === "image-upscaler" && (
      <ImageUpscaler locale={locale} copy={bundle.tools[page].feature} />
    )
  }
  {
    dataMode && dataFeature && (
      <DataConverter
        locale={locale}
        mode={dataMode}
        modeLabels={dataModeLabels}
        copy={dataFeature}
        help={bundle.help}
        textDirection={technicalDirection}
      />
    )
  }
  {
    page === "html-formatter" && (
      <HtmlFormatter
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        help={bundle.help}
      />
    )
  }
  {
    page === "css-formatter" && (
      <CssFormatter
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        help={bundle.help}
      />
    )
  }
  {
    page === "javascript-formatter" && (
      <JavaScriptFormatter
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        help={bundle.help}
      />
    )
  }
  {
    page === "sql-formatter" && (
      <SqlFormatter
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        help={bundle.help}
      />
    )
  }
  {
    page === "ip-subnet-calculator" && (
      <IpSubnetCalculator
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        sampleInput="192.168.1.10/24"
      />
    )
  }
  {
    isDateCalculatorPage(page) && (
      <DateCalculator
        locale={locale}
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        initialMode={dateCalculatorModes[page]}
      />
    )
  }
  {
    page === "time-zone-converter" && (
      <TimeZoneConverter
        locale={locale}
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        popularZones={bundle.preview.time.popularZones}
      />
    )
  }
  {
    isMathCalculatorPage(page) && (
      <MathCalculator
        locale={locale}
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
        initialMode={mathCalculatorModes[page]}
        modeLinks={mathModeLinks}
      />
    )
  }
  {
    page === "percentage-calculator" && (
      <PercentageCalculator
        locale={locale}
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
      />
    )
  }
  {
    page === "bmi-calculator" && (
      <BmiCalculator
        locale={locale}
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
      />
    )
  }
  {
    page === "uuid-generator" && (
      <UuidGenerator
        copy={bundle.tools[page].feature}
        commonCopy={bundle.common}
      />
    )
  }
</PreviewToolPage>
