---
interface Props {
  toolId: string;
}

const { toolId } = Astro.props;
const illustrations: Record<string, string> = {
  "background-remover": "/illustrations/featured/background-remover.svg",
  "compress-pdf": "/illustrations/featured/compress-pdf.svg",
  "image-upscaler": "/illustrations/featured/image-upscaler.svg",
  "ai-watermark-remover": "/illustrations/featured/ai-watermark-remover.svg",
  "merge-pdf": "/illustrations/featured/merge-pdf.svg",
  "word-counter": "/illustrations/featured/word-counter.svg",
  "qr-code-generator": "/illustrations/featured/qr-code-generator.svg",
  "json-formatter": "/illustrations/featured/json-formatter.svg",
  "image-resizer": "/illustrations/featured/image-resizer.svg",
};
const src = illustrations[toolId];
---

<span class="tool-pictogram" aria-hidden="true">
  <img src={src} alt="" width="128" height="128" decoding="async" />
</span>
