---
import { networkCopy } from "../lib/tool-catalog";
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const promise = networkCopy[locale].toolPromise;
const lines = [promise.improvement, promise.privacy, promise.bookmark];
---

<ul class="tool-promise">
  {
    lines.map((line) => (
      <li class="tool-promise-item">
        <svg
          class="tool-promise-sparkle"
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M8 1.5c.55 3.15 1.35 3.95 4.5 4.5-3.15.55-3.95 1.35-4.5 4.5C7.45 7.35 6.65 6.55 3.5 6 6.65 5.45 7.45 4.65 8 1.5Z" />
        </svg>
        <span>{line}</span>
      </li>
    ))
  }
</ul>

<style>
  .tool-promise {
    list-style: none;
    display: grid;
    gap: var(--space-1);
  }

  .tool-promise-item {
    min-width: 0;
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
  }

  .tool-promise-sparkle {
    margin-top: 2px;
    color: var(--muted);
  }
</style>
