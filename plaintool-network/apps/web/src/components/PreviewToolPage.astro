---
import FaqSection from "./FaqSection.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import ToolPromise from "./ToolPromise.astro";
import { networkCopy, toolCatalog } from "../lib/tool-catalog";
import { previewCopy } from "../lib/tool-i18n";
import { type Locale, type ToolPage } from "../lib/site";
import { breadcrumbSchema, faqSchema, webApplicationSchema } from "../lib/seo";
import {
  sourceReferenceCopy,
  type SourceReference,
} from "../lib/source-references";
interface Props {
  locale: Locale;
  page: ToolPage;
  title: string;
  heading?: string;
  description: string;
  guideTitle: string;
  guideBody: string;
  guideFactKind?: string;
  safetyTitle?: string;
  safetyBody?: string;
  faqs: Array<{ q: string; a: string }>;
  sources?: readonly SourceReference[];
  featureStylesheet?: string;
}
const {
  locale,
  page,
  title,
  heading,
  description,
  guideTitle,
  guideBody,
  guideFactKind,
  safetyTitle,
  safetyBody,
  faqs,
  sources = [],
  featureStylesheet,
} = Astro.props;
const n = networkCopy[locale];
const c = previewCopy[locale].common;
const mobileDescription =
  toolCatalog.find((tool) => tool.slug === page)?.summary[locale] ??
  description;
const structuredData = [
  breadcrumbSchema({
    locale,
    page,
    homeLabel: n.allTools,
    itemLabel: title,
  }),
  webApplicationSchema({
    locale,
    page,
    name: title,
    description,
  }),
  faqSchema(faqs),
];
---

<SiteLayout
  locale={locale}
  page={page}
  title={`${title} | AbsolTools`}
  description={description}
  structuredData={structuredData}
  featureStylesheet={featureStylesheet}
>
  <section class="tool-intro">
    <div class="tool-intro-copy">
      <h1>{heading ?? title}</h1><p
        class="hero-subheading hero-subheading-desktop"
      >
        {description}
      </p><p class="hero-subheading hero-subheading-mobile">
        {mobileDescription}
      </p>
      <ToolPromise locale={locale} />
    </div>
  </section>
  <div class="tool-shell"><slot /></div>
  <div class="content-sections">
    <section class="content-section">
      <h2>{guideTitle}</h2><p data-conversion-fact={guideFactKind}>
        {guideBody}
      </p>
    </section>
    {
      safetyTitle && safetyBody && (
        <section class="content-section">
          <>
            <h2>{safetyTitle}</h2>
            <p>{safetyBody}</p>
          </>
        </section>
      )
    }
    {
      sources.length > 0 && (
        <section class="content-section source-references">
          <h2>{sourceReferenceCopy[locale].heading}</h2>
          <ul>
            {sources.map((source) => (
              <li>
                <a href={source.href} target="_blank" rel="noopener noreferrer">
                  {source.title}
                </a>{" "}
                <span>— {source.publisher}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <FaqSection title={c.faqTitle} faqs={faqs} />
  </div>
</SiteLayout>
