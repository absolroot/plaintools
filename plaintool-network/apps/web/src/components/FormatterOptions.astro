---
import UiIcon from "./UiIcon.astro";
import "./formatter-options.css";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<details class="formatter-options">
  <summary>
    <UiIcon name="chevron-right" class="formatter-options-chevron" />
    <span>{label}</span>
  </summary>
  <div class="formatter-options-body">
    <slot />
  </div>
</details>
