---
import ToolDirectoryCard from "./ToolDirectoryCard.astro";
import UiIcon from "./UiIcon.astro";
import type { ToolCatalogItem, ToolCategory } from "../lib/tool-catalog";
import type { Locale } from "../lib/site";

interface RepresentativeCard {
  tool: ToolCatalogItem;
  displayName: string;
  subtitle: string;
  mark: string;
  markId: string;
}

interface Props {
  category: ToolCategory;
  title: string;
  tools: ToolCatalogItem[];
  locale: Locale;
  initiallyVisibleToolCount?: number;
  collapsedLabel?: string;
  representativeCard?: RepresentativeCard;
}

const {
  category,
  title,
  tools,
  locale,
  initiallyVisibleToolCount = tools.length,
  collapsedLabel,
  representativeCard,
} = Astro.props;
const initiallyVisibleTools = tools.slice(0, initiallyVisibleToolCount);
const collapsedTools = tools.slice(initiallyVisibleToolCount);
if (collapsedTools.length > 0 && !collapsedLabel) {
  throw new Error(`Missing collapsed tool label for ${category}.`);
}
---

<section
  class="directory-category"
  data-directory-search-category
  data-directory-category={category}
>
  <div class="directory-category-heading">
    <h2>{title}</h2>
    <span aria-hidden="true" data-directory-search-category-count>
      {String(tools.length).padStart(2, "0")}
    </span>
  </div>
  <div
    class:list={[
      "tool-directory-grid",
      { "image-converter-featured-grid": representativeCard },
    ]}
  >
    {
      initiallyVisibleTools.map((tool) => (
        <ToolDirectoryCard tool={tool} locale={locale} />
      ))
    }
    {
      representativeCard && (
        <ToolDirectoryCard
          tool={representativeCard.tool}
          locale={locale}
          displayName={representativeCard.displayName}
          subtitle={representativeCard.subtitle}
          mark={representativeCard.mark}
          markId={representativeCard.markId}
          searchable={false}
        />
      )
    }
  </div>
  {
    collapsedTools.length > 0 && (
      <details class="image-converter-more" data-directory-search-more>
        <summary>
          <span>{collapsedLabel}</span>
          <span class="image-converter-more-count" aria-hidden="true">
            {String(collapsedTools.length).padStart(2, "0")}
          </span>
          <UiIcon
            name="chevron-right"
            size={16}
            class="image-converter-more-icon"
          />
        </summary>
        <div class="tool-directory-grid image-converter-more-grid">
          {collapsedTools.map((tool) => (
            <ToolDirectoryCard tool={tool} locale={locale} />
          ))}
        </div>
      </details>
    )
  }
</section>
