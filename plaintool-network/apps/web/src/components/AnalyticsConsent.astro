---
import { siteConfig } from "../lib/site";

const { cookiebotDomainGroupId, ga4MeasurementId, googleCmpEnabled } =
  siteConfig.integrations;
const enabled = Boolean(
  googleCmpEnabled && cookiebotDomainGroupId && ga4MeasurementId,
);
const googleTagSource = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4MeasurementId)}`;
---

{
  enabled && (
    <>
      <script
        is:inline
        id="Cookiebot"
        src="https://consent.cookiebot.com/uc.js"
        data-cbid={cookiebotDomainGroupId}
        type="text/javascript"
        async
      />
      <script
        is:inline
        src={googleTagSource}
        type="text/plain"
        data-cookieconsent="statistics"
        async
      />
      <script
        is:inline
        src="/ga4-init.js"
        data-measurement-id={ga4MeasurementId}
        type="text/plain"
        data-cookieconsent="statistics"
      />
    </>
  )
}
