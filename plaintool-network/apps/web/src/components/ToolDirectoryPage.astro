---
import SiteLayout from "../layouts/SiteLayout.astro";
import ToolDirectorySearch from "./ToolDirectorySearch.astro";
import ToolDirectorySection from "./ToolDirectorySection.astro";
import ToolMark from "./ToolMark.astro";
import ToolPictogram from "./ToolPictogram.astro";
import { imageConverterLocales } from "../features/image-converter/i18n";
import {
  homeDirectoryCategoryOrder,
  homeDirectoryFeaturedTools,
  homeDirectoryInitiallyVisibleToolCount,
  homeDirectoryToolsForCategory,
  homeDirectoryToolsInDisplayOrder,
  networkCopy,
  toolPath,
} from "../lib/tool-catalog";
import {
  absoluteUrl,
  type Locale,
  localizedPath,
  type ToolPage,
} from "../lib/site";
import { itemListSchema } from "../lib/seo";

interface Props {
  locale: Locale;
  includeIntegrations?: boolean;
}
const { locale, includeIntegrations = true } = Astro.props;
const n = networkCopy[locale];
const featuredPictogramIds = new Set([
  "background-remover",
  "compress-pdf",
  "image-upscaler",
  "ai-watermark-remover",
  "merge-pdf",
  "word-counter",
  "qr-code-generator",
  "json-formatter",
]);
const featuredCardName = (
  tool: (typeof homeDirectoryFeaturedTools)[number],
) => {
  const name = tool.name[locale];
  if (tool.id === "image-upscaler") {
    return name.replace(/\s*[\(（][^\)）]*[\)）]\s*$/u, "");
  }
  if (tool.id === "ai-watermark-remover") {
    return name.replace(/\s+-\s+.+$/u, "");
  }
  return name;
};
const directoryCategoriesId = "tool-directory-categories";
const imageConverterEntryTool = homeDirectoryToolsForCategory("image").find(
  (tool) => tool.id === "png-to-webp",
);
if (!imageConverterEntryTool) {
  throw new Error("Missing image format converter directory entry tool.");
}
const imageConverterRepresentativeCard = {
  tool: imageConverterEntryTool,
  displayName:
    imageConverterLocales[locale].tools["png-to-webp"].feature.ariaLabel,
  subtitle: "",
  mark: "IMG",
  markId: "image-converter",
};
const publicItems = homeDirectoryToolsInDisplayOrder
  .filter((tool) => tool.status === "available" && tool.slug)
  .map((tool) => ({
    name: tool.name[locale],
    url: absoluteUrl(localizedPath(locale, tool.slug as ToolPage)),
  }));
---

<SiteLayout
  locale={locale}
  includeIntegrations={includeIntegrations}
  title={n.directoryMetaTitle}
  description={n.directoryMetaDescription}
  structuredData={[itemListSchema(publicItems)]}
>
  <slot name="head" slot="head" />
  <article class="tool-directory">
    <header class="directory-header">
      <h1>{n.directoryTitle}</h1><p>{n.directoryIntro}</p>
    </header>
    <ToolDirectorySearch
      locale={locale}
      targetId={directoryCategoriesId}
      totalCount={homeDirectoryToolsInDisplayOrder.length}
    />
    <nav
      class="directory-featured"
      aria-label={n.catalogAria}
      data-directory-search-intro
    >
      {
        homeDirectoryFeaturedTools.map((tool) => (
          <a class="directory-featured-link" href={toolPath(locale, tool)}>
            {featuredPictogramIds.has(tool.id) ? (
              <ToolPictogram toolId={tool.id} />
            ) : (
              <ToolMark toolId={tool.id} mark={tool.mark} />
            )}
            <span class="directory-featured-copy">
              <strong>{featuredCardName(tool)}</strong>
              <small>{tool.summary[locale]}</small>
            </span>
          </a>
        ))
      }
    </nav>
    <div class="directory-browse">
      <nav
        class="directory-jump"
        aria-label={n.allTools}
        data-directory-search-intro
      >
        <span class="directory-jump-title">{n.allTools}</span>
        {
          homeDirectoryCategoryOrder.map((category) => (
            <a href={`#directory-${category}`}>
              <span>{n.categories[category]}</span>
              <span aria-hidden="true">
                {String(
                  homeDirectoryToolsForCategory(category).length,
                ).padStart(2, "0")}
              </span>
            </a>
          ))
        }
      </nav>
      <div
        class="directory-categories"
        id={directoryCategoriesId}
        aria-label={n.catalogAria}
      >
        {
          homeDirectoryCategoryOrder.map((category) => (
            <ToolDirectorySection
              category={category}
              title={n.categories[category]}
              tools={homeDirectoryToolsForCategory(category)}
              locale={locale}
              initiallyVisibleToolCount={homeDirectoryInitiallyVisibleToolCount(
                category,
              )}
              collapsedLabel={n.allTools}
              representativeCard={
                category === "image"
                  ? imageConverterRepresentativeCard
                  : undefined
              }
            />
          ))
        }
      </div>
    </div>
  </article>
</SiteLayout>
