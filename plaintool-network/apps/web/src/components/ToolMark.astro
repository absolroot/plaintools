---
interface Props {
  toolId: string;
  mark: string;
}

const { toolId, mark } = Astro.props;
const iconIds = new Set([
  "word-counter",
  "unix-timestamp-converter",
  "text-compare",
  "ai-watermark-remover",
  "qr-code-generator",
  "qr-code-scanner",
  "barcode-generator",
  "password-generator",
  "ip-subnet-calculator",
  "background-remover",
  "image-upscaler",
  "compress-pdf",
  "merge-pdf",
  "split-pdf",
  "pdf-to-image",
  "image-to-pdf",
]);
---

<span class="tool-mark" aria-hidden="true">
  {
    iconIds.has(toolId) ? (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        focusable="false"
      >
        {toolId === "word-counter" && (
          <>
            <path d="M8 6h12M8 12h12M8 18h8" />
            <path d="M4 6h.01M4 12h.01M4 18h.01" stroke-width="2.5" />
          </>
        )}
        {toolId === "unix-timestamp-converter" && (
          <>
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7v5l3 2" />
          </>
        )}
        {toolId === "text-compare" && (
          <>
            <path d="M4 7h10M11 4l3 3-3 3M20 17H10M13 14l-3 3 3 3" />
          </>
        )}
        {toolId === "ai-watermark-remover" && (
          <>
            <path d="m12 3 1.1 3.1L16 7.5l-2.9 1.4L12 12l-1.1-3.1L8 7.5l2.9-1.4L12 3Z" />
            <path d="m18 13 .8 2.2L21 16l-2.2.8L18 19l-.8-2.2L15 16l2.2-.8L18 13ZM6 13l.7 2.3L9 16l-2.3.7L6 19l-.7-2.3L3 16l2.3-.7L6 13Z" />
          </>
        )}
        {toolId === "qr-code-generator" && (
          <>
            <rect width="5" height="5" x="3" y="3" rx="1" />
            <rect width="5" height="5" x="16" y="3" rx="1" />
            <rect width="5" height="5" x="3" y="16" rx="1" />
            <path d="M21 16h-3a2 2 0 0 0-2 2v3M21 21v.01M12 7v3a2 2 0 0 1-2 2H7M3 12h.01M12 3h.01M12 16v.01M16 12h1M21 12v.01M12 21v-1" />
          </>
        )}
        {toolId === "qr-code-scanner" && (
          <>
            <path d="M7 3H5a2 2 0 0 0-2 2v2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2" />
            <rect x="7" y="7" width="4" height="4" rx=".5" />
            <path d="M15 7h2v2h-2zM7 15h2v2H7zM13 13h4v4h-4z" />
          </>
        )}
        {toolId === "barcode-generator" && (
          <>
            <path d="M4 5v14M7 5v14M10 5v14M14 5v14M17 5v14M20 5v14" />
            <path d="M4 5h3M17 19h3" />
          </>
        )}
        {toolId === "password-generator" && (
          <>
            <circle cx="8" cy="12" r="4" />
            <path d="M12 12h8M16 12v3M19 12v2" />
          </>
        )}
        {toolId === "ip-subnet-calculator" && (
          <>
            <circle cx="12" cy="5" r="2" />
            <circle cx="5" cy="18" r="2" />
            <circle cx="19" cy="18" r="2" />
            <path d="M12 7v4M5 16v-3h14v3" />
          </>
        )}
        {toolId === "background-remover" && (
          <>
            <rect
              x="3.5"
              y="3.5"
              width="13"
              height="13"
              rx="2"
              stroke-dasharray="2 2"
            />
            <path
              d="m12.5 11.5 7.25 3.15-3.1 1.15-1.15 3.2-3-7.5Z"
              fill="currentColor"
            />
          </>
        )}
        {toolId === "image-upscaler" && (
          <>
            <rect x="3.5" y="7.5" width="13" height="12" rx="2" />
            <circle cx="7.5" cy="11.5" r="1.25" />
            <path d="m4.5 18 4-4 2.5 2.5 2-2 2.5 2.5" />
            <path d="m14 10 6-6M15 4h5v5" />
          </>
        )}
        {toolId === "compress-pdf" && (
          <>
            <path d="M6 3h8l4 4v14H6zM14 3v5h4" />
            <path d="M9 10v3h3M15 18v-3h-3M9 13l-2-2M15 15l2 2" />
          </>
        )}
        {toolId === "merge-pdf" && (
          <>
            <path d="M5 7V3h10l4 4v10h-4M15 3v5h4" />
            <rect x="3" y="9" width="12" height="12" rx="1" />
            <path d="M9 12v6M6 15h6" />
          </>
        )}
        {toolId === "split-pdf" && (
          <>
            <path d="M6 3h8l4 4v14H6zM14 3v5h4" />
            <path d="M8 12h8" stroke-dasharray="2 2" />
            <circle cx="9" cy="16" r="1.5" />
            <circle cx="15" cy="16" r="1.5" />
            <path d="m10.2 15 3.8-4M13.8 15 10 11" />
          </>
        )}
        {toolId === "pdf-to-image" && (
          <>
            <path d="M3 4h7v7H3zM6.5 4v3H10" />
            <path d="M11 8h4M13 6l2 2-2 2" />
            <rect x="14" y="12" width="7" height="7" rx="1" />
            <circle cx="16.5" cy="14.5" r=".75" />
            <path d="m15 18 2-2 1.25 1.25 1-1L20 17" />
          </>
        )}
        {toolId === "image-to-pdf" && (
          <>
            <rect x="3" y="5" width="7" height="7" rx="1" />
            <circle cx="5.5" cy="7.5" r=".75" />
            <path d="m4 11 2-2 1.25 1.25 1-1L9 10" />
            <path d="M11 9h4M13 7l2 2-2 2" />
            <path d="M14 13h7v7h-7zM17.5 13v3H21" />
          </>
        )}
      </svg>
    ) : (
      mark
    )
  }
</span>
