---
import { toolIllustrationSrc } from "../lib/tool-illustrations";

interface Props {
  toolId: string;
  mark: string;
}

const { toolId } = Astro.props;
---

<span class="tool-mark" aria-hidden="true">
  <img
    src={toolIllustrationSrc(toolId)}
    alt=""
    width="128"
    height="128"
    decoding="async"
  />
</span>
