---
type IconName =
  | "calendar"
  | "check"
  | "chevron-right"
  | "copy"
  | "download"
  | "folder-open"
  | "grid"
  | "help-circle"
  | "languages"
  | "moon"
  | "search"
  | "shield"
  | "sun"
  | "x";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = "" } = Astro.props;
---

<svg
  class:list={["ui-icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "calendar" && (
      <>
        <rect width="18" height="18" x="3" y="4" rx="1" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </>
    )
  }
  {name === "check" && <path d="m5 12 4 4L19 6" />}
  {name === "chevron-right" && <path d="m9 18 6-6-6-6" />}
  {
    name === "copy" && (
      <>
        <rect width="13" height="13" x="9" y="9" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </>
    )
  }
  {
    name === "download" && (
      <>
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <path d="m7 10 5 5 5-5" />
        <path d="M12 15V3" />
      </>
    )
  }
  {
    name === "folder-open" && (
      <>
        <path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69 .9l.82 1.2A2 2 0 0 0 12.07 6H18a2 2 0 0 1 2 2v2" />
      </>
    )
  }
  {
    name === "grid" && (
      <>
        <rect width="7" height="7" x="3" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="3" rx="1" />
        <rect width="7" height="7" x="14" y="14" rx="1" />
        <rect width="7" height="7" x="3" y="14" rx="1" />
      </>
    )
  }
  {
    name === "help-circle" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M9.7 9a2.4 2.4 0 0 1 4.6 1c0 1.8-2.3 2-2.3 3.7" />
        <path d="M12 17h.01" />
      </>
    )
  }
  {
    name === "languages" && (
      <>
        <path d="m5 8 6 6" />
        <path d="m4 14 6-6 2-3" />
        <path d="M2 5h12" />
        <path d="M7 2h1" />
        <path d="m22 22-5-10-5 10" />
        <path d="M14 18h6" />
      </>
    )
  }
  {
    name === "shield" && (
      <>
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
      </>
    )
  }
  {
    name === "moon" && (
      <path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z" />
    )
  }
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-4-4" />
      </>
    )
  }
  {
    name === "x" && (
      <>
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </>
    )
  }
</svg>
