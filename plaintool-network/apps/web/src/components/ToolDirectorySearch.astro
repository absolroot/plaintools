---
import UiIcon from "./UiIcon.astro";
import { networkCopy } from "../lib/tool-catalog";
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
  targetId: string;
  totalCount: number;
}

const { locale, targetId, totalCount } = Astro.props;
const copy = networkCopy[locale];
const inputId = `tool-directory-search-${locale}`;
const initialCount = copy.directorySearchCount.replace(
  "{count}",
  String(totalCount),
);
---

<div
  class="directory-search"
  role="search"
  aria-label={copy.directorySearchLabel}
  data-directory-search
  data-directory-search-locale={locale}
  data-directory-search-count={copy.directorySearchCount}
>
  <label class="visually-hidden" for={inputId}
    >{copy.directorySearchLabel}</label
  >
  <div class="directory-search-control">
    <span class="directory-search-icon" aria-hidden="true">
      <UiIcon name="search" size={16} />
    </span>
    <input
      id={inputId}
      class="directory-search-input"
      type="search"
      placeholder={copy.directorySearchPlaceholder}
      autocomplete="off"
      autocapitalize="none"
      spellcheck="false"
      enterkeyhint="search"
      aria-controls={targetId}
      data-directory-search-input
    />
    <button
      class="directory-search-clear"
      type="button"
      aria-label={copy.directorySearchClear}
      title={copy.directorySearchClear}
      data-directory-search-clear
      hidden
    >
      <UiIcon name="x" size={16} />
    </button>
  </div>
  <p
    class="visually-hidden"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-directory-search-status
  >
    {initialCount}
  </p>
  <p class="directory-search-empty" data-directory-search-empty hidden>
    {copy.directorySearchNoResults}
  </p>
</div>

<script>
  import {
    matchesToolDirectorySearch,
    normalizeToolDirectorySearch,
  } from "../lib/tool-directory-search";
  import type { Locale } from "../lib/site";

  const roots = document.querySelectorAll<HTMLElement>(
    "[data-directory-search]",
  );

  for (const root of roots) {
    if (root.dataset.directorySearchBound === "true") continue;
    root.dataset.directorySearchBound = "true";

    const input = root.querySelector<HTMLInputElement>(
      "[data-directory-search-input]",
    );
    const clear = root.querySelector<HTMLButtonElement>(
      "[data-directory-search-clear]",
    );
    const status = root.querySelector<HTMLElement>(
      "[data-directory-search-status]",
    );
    const empty = root.querySelector<HTMLElement>(
      "[data-directory-search-empty]",
    );
    const targetId = input?.getAttribute("aria-controls");
    const directory = targetId ? document.getElementById(targetId) : null;

    if (!input || !clear || !status || !empty || !directory) continue;

    const locale = root.dataset.directorySearchLocale as Locale;
    const countTemplate = root.dataset.directorySearchCount ?? "{count}";
    const cards = Array.from(
      directory.querySelectorAll<HTMLElement>("[data-directory-search-card]"),
    );
    const categories = Array.from(
      directory.querySelectorAll<HTMLElement>(
        "[data-directory-search-category]",
      ),
    );
    let composing = false;

    const applyFilter = () => {
      const query = input.value;
      const hasQuery = normalizeToolDirectorySearch(query, locale).length > 0;
      let visibleCount = 0;

      for (const card of cards) {
        const matches = matchesToolDirectorySearch(
          card.dataset.directorySearchCorpus ?? "",
          query,
          locale,
        );
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      for (const category of categories) {
        const categoryCards = Array.from(
          category.querySelectorAll<HTMLElement>(
            "[data-directory-search-card]",
          ),
        );
        const categoryCount = categoryCards.filter(
          (card) => !card.hidden,
        ).length;
        const count = category.querySelector<HTMLElement>(
          "[data-directory-search-category-count]",
        );
        if (count) count.textContent = String(categoryCount).padStart(2, "0");
        category.hidden = hasQuery && categoryCount === 0;
      }

      clear.hidden = input.value.length === 0;
      empty.hidden = !hasQuery || visibleCount !== 0;
      status.textContent = countTemplate.replace(
        "{count}",
        String(visibleCount),
      );
    };

    const clearSearch = () => {
      input.value = "";
      applyFilter();
      input.focus();
    };

    input.addEventListener("compositionstart", () => {
      composing = true;
    });
    input.addEventListener("compositionend", () => {
      composing = false;
      applyFilter();
    });
    input.addEventListener("input", () => {
      if (!composing) applyFilter();
    });
    input.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || input.value.length === 0) return;
      event.preventDefault();
      clearSearch();
    });
    clear.addEventListener("pointerdown", (event) => {
      event.preventDefault();
    });
    clear.addEventListener("click", clearSearch);
    applyFilter();
  }
</script>

<style>
  .directory-search {
    width: 100%;
    margin-top: var(--space-6);
  }

  .directory-search-control {
    width: 100%;
    height: 36px;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 36px;
    align-items: center;
    border-radius: var(--radius-control);
    color: var(--ink);
    background: var(--control);
    box-shadow: 0 0 0 1px var(--line);
  }

  .directory-search-control:focus-within {
    box-shadow: 0 0 0 1.5px var(--focus-ring);
  }

  .directory-search-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    color: var(--muted);
  }

  .directory-search-input {
    min-width: 0;
    width: 100%;
    height: 36px;
    padding: 0 var(--space-2);
    border: 0;
    outline: 0;
    border-radius: var(--radius-control);
    color: var(--ink);
    background: transparent;
    font-family: var(--sans);
    font-size: 14px;
    appearance: none;
  }

  .directory-search-input::placeholder {
    color: var(--placeholder);
    opacity: 1;
  }

  .directory-search-input::-webkit-search-cancel-button {
    display: none;
  }

  .directory-search-clear {
    width: 36px;
    height: 36px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: var(--radius-control);
    color: var(--muted);
    background: transparent;
    cursor: pointer;
  }

  .directory-search-clear:hover {
    color: var(--ink);
    background: var(--tint);
  }

  .directory-search-empty {
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 680px) {
    .directory-search {
      margin-top: var(--space-5);
    }

    .directory-search-control {
      height: 44px;
      grid-template-columns: 44px minmax(0, 1fr) 44px;
    }

    .directory-search-icon,
    .directory-search-input,
    .directory-search-clear {
      height: 44px;
    }

    .directory-search-icon,
    .directory-search-clear {
      width: 44px;
    }

    .directory-search-empty {
      margin-top: var(--space-5);
    }
  }
</style>
