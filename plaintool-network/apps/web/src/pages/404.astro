---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  locale="en"
  title="Page not found | AbsolTools"
  description="The requested page could not be found."
  noindex
  canonicalize={false}
>
  <article class="not-found-page">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <p>The address may be incorrect, or the tool may have moved.</p>
    <a class="primary-button inline-action" href="/en/">Back to all tools</a>
  </article>
</SiteLayout>
