      },
      {
        id: "visa-sg",
        label: "Visa Infinite Singapore",
        region: "Singapore",
        kind: "official offer",
        market: "싱가포르",
        eligibility: "싱가포르 발급 Visa Infinite 및 공식 혜택 조건 확인",
        routeKind: "official",
        preservesHotel: false,
        status: "official",
        url: "https://www.agoda.com/VisaInfiniteSG",
      },
      {
        id: "visa-my",
        label: "Visa Infinite Malaysia",
        region: "Malaysia",
        kind: "official offer",
        market: "말레이시아",
        eligibility: "말레이시아 발급 Visa Infinite 및 공식 혜택 조건 확인",
        routeKind: "official",
        preservesHotel: false,
        status: "official",
        url: "https://www.agoda.com/VisaInfiniteMY",
      },
      {
        id: "visa-my-standard",
        label: "Visa Malaysia Agoda offer",
        region: "Malaysia",
        kind: "official offer",
        market: "말레이시아",
        eligibility:
          "말레이시아 발급 Visa 대상. 대상 숙소·선결제·카드 등급과 예약·숙박 기간을 공식 약관에서 확인",
        routeKind: "official",
        preservesHotel: false,
        status: "official",
        url: "https://www.agoda.com/visamy",
      },
      {
