      observedCid(
        "nz-visa",
        "호주·뉴질랜드",
        "New Zealand Visa",
        "1889309",
        "뉴질랜드 발급 Visa 카드",
      ),
      observedCid(
        "au-nz-mc",
        "호주·뉴질랜드",
        "Mastercard",
        "1889485",
        "호주·뉴질랜드 발급 개인 Mastercard",
      ),
    ];
    const discoveryMetadata: Record<
      string,
      Pick<
        Candidate,
        | "label"
        | "market"
        | "eligibility"
        | "routeKind"
        | "preservesHotel"
        | "status"
      >
    > = {
      "maps-1": {
        label: "Google 지도 경로 1",
        market: "글로벌",
        eligibility: "공개 지도 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "maps-2": {
        label: "Google 지도 경로 2",
        market: "글로벌",
        eligibility: "공개 지도 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "maps-3": {
        label: "Google 지도 경로 3",
        market: "글로벌",
        eligibility: "공개 지도 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "search-1": {
        label: "Google 검색 경로 1",
        market: "글로벌",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "search-2": {
        label: "Google 검색 경로 2",
        market: "글로벌",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "search-3": {
        label: "Google 검색 경로 3",
        market: "글로벌",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      naver: {
        label: "네이버 검색 경로",
        market: "대한민국",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
    };
    const candidates = [
      ...decodeCatalog(window.__ABSOL_TRAVEL_CATALOG__).map((candidate) => ({
        ...candidate,
        ...directMetadata[candidate.id],
      })),
      ...decodeCatalog(window.__ABSOL_TRAVEL_DISCOVERY__).map((candidate) => ({
        ...candidate,
        ...discoveryMetadata[candidate.id],
      })),
      ...regionalCidCandidates,
      ...regionalOffers,
    ];
    const marketByLanguage: Record<string, string> = {
      ko: "대한민국",
      ja: "일본",
      "zh-cn": "중국 본토",
      "zh-tw": "대만",
      "zh-hk": "홍콩",
      "en-sg": "싱가포르",
      "en-my": "말레이시아",
      "en-ph": "필리핀",
      "en-au": "호주·뉴질랜드",
      "en-nz": "호주·뉴질랜드",
      "ms-my": "말레이시아",
      "th-th": "태국",
      "vi-vn": "베트남",
      "id-id": "인도네시아",
      "fil-ph": "필리핀",
      "tl-ph": "필리핀",
    };
    const preferredLanguages = [
      document.documentElement.lang,
      ...navigator.languages,
    ].map((value) => value.toLowerCase());
    const preferredMarket = preferredLanguages
      .map(
        (language) =>
          marketByLanguage[language] ??
          marketByLanguage[language.split("-")[0]],
      )
      .find(Boolean);
    market.value = preferredMarket ?? "";
    status.textContent = candidates.length ? "" : copy.catalogUnavailable;
    generate.disabled = candidates.length === 0;
    const safeHotelUrl = (value: string): URL | null => {
      try {
        const pasted = value.trim().replace(/^[\s"'“”‘’]+|[\s"'“”‘’]+$/g, "");
        const source = new URL(
          /^https?:\/\//i.test(pasted) ? pasted : `https://${pasted}`,
        );
        if (
          source.protocol !== "https:" ||
          !(
            source.hostname === "agoda.com" ||
            source.hostname.endsWith(".agoda.com")
          )
        )
          return null;
        const output = new URL(source.origin + source.pathname);
        [
          "countryId",
          "finalPriceView",
          "isShowMobileAppPrice",
          "numberOfBedrooms",
          "familyMode",
          "adults",
          "children",
          "rooms",
          "maxRooms",
          "checkIn",
          "checkOut",
          "isCalendarCallout",
          "childAges",
          "numberOfGuest",
          "missingChildAges",
          "travellerType",
          "showReviewSubmissionEntry",
          "currencyCode",
          "isFreeOccSearch",
          "tspTypes",
          "los",
        ].forEach((key) => {
          const parameter = source.searchParams.get(key);
          if (parameter !== null) output.searchParams.set(key, parameter);
        });
        return output;
      } catch {
        return null;
      }
    };
    let activeHotel: URL | null = null;
    let activeMarket = market.value;
    const groupLabels: Record<"hotel" | "search" | "official", string> = {
      hotel: copy.hotelGroup,
      search: copy.searchGroup,
      official: copy.officialGroup,
    };
    const candidateMatches = (candidate: Candidate) => {
      const marketMatches = candidate.market === activeMarket;
      return marketMatches;
    };
    const renderResults = () => {
      if (!activeHotel) return;
      const visible = candidates.filter(candidateMatches);
      const groups = new Map<string, Candidate[]>();
      visible.forEach((candidate) => {
        const group = candidate.routeKind ?? "hotel";
        groups.set(group, [...(groups.get(group) ?? []), candidate]);
      });
      const fragment = document.createDocumentFragment();
      if (!groups.size) {
        const empty = document.createElement("p");
        empty.className = "travel-link-empty";
        empty.textContent = copy.empty;
        fragment.append(empty);
      }
      groups.forEach((groupCandidates, group) => {
        const section = document.createElement("section");
        section.className = "travel-link-result-group";
        const heading = document.createElement("h3");
        heading.textContent =
          groupLabels[group as "hotel" | "search" | "official"] ?? group;
        const list = document.createElement("div");
        list.className = "travel-link-card-list";
        groupCandidates.forEach((candidate) => {
          const card = document.createElement("article");
          card.className = "travel-link-card";
          card.dataset.travelCard = candidate.id;
          const cardCopy = document.createElement("div");
          cardCopy.className = "travel-link-card-copy";
          const title = document.createElement("h4");
          title.textContent = candidate.label;
          const detail = document.createElement("p");
          detail.className = "travel-link-card-detail";
          detail.textContent = `${candidate.preservesHotel ? copy.preservesHotel : copy.doesNotPreserveHotel} · ${copy.eligibility}`;
          cardCopy.append(title, detail);
          const link = document.createElement("a");
          link.className = "secondary-button";
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          if (candidate.routeKind === "official") {
            link.href = candidate.url!;
            link.textContent = copy.openOfficial;
          } else {
            const url = new URL(activeHotel!);
            url.searchParams.set("cid", candidate.cid!);
            link.href = url.toString();
            link.textContent = copy.openAgoda;
          }
          card.append(cardCopy, link);
          list.append(card);
        });
        section.append(heading, list);
        fragment.append(section);
      });
      grid.replaceChildren(fragment);
    };
    const render = () => {
      if (!market.value) {
        results.hidden = true;
        root.classList.remove("is-success");
        root.classList.add("has-error");
        status.textContent = copy.selectMarket;
        market.focus();
        return;
      }
      const hotel = safeHotelUrl(input.value);
      if (!hotel) {
        results.hidden = true;
        root.classList.remove("is-success");
        root.classList.add("has-error");
        status.textContent = copy.invalidUrl;
        input.focus();
        return;
      }
      activeHotel = hotel;
      activeMarket = market.value;
      renderResults();
      results.hidden = false;
      root.classList.remove("has-error", "is-success");
      status.textContent = "";
      if (window.matchMedia("(max-width: 680px)").matches)
        results.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    generate.addEventListener("click", render);
    input.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key === "Enter") render();
    });
    clear.addEventListener("click", () => {
      input.value = "";
      results.hidden = true;
      grid.replaceChildren();
      activeHotel = null;
      root.classList.remove("is-success", "has-error");
      status.textContent = candidates.length ? "" : copy.catalogUnavailable;
      input.focus();
    });
    market.addEventListener("change", () => {
      activeMarket = market.value;
      if (activeHotel && activeMarket) {
        renderResults();
        results.hidden = false;
      } else {
        results.hidden = true;
      }
      root.classList.remove("has-error");
      status.textContent = candidates.length ? "" : copy.catalogUnavailable;
    });
    input.addEventListener("input", () => {
      root.classList.remove("has-error");
    });
  }
</script>
