        kind: "official offer",
        market: "대만",
        eligibility: "대만 발급 American Express 및 공식 혜택 조건 확인",
        routeKind: "official",
        preservesHotel: false,
        status: "official",
        url: "https://www.agoda.com/amextw",
      },
      {
        id: "amex-hk",
        label: "American Express Hong Kong",
        region: "Hong Kong",
        kind: "official offer",
        market: "홍콩",
        eligibility: "홍콩 발급 American Express 및 공식 혜택 조건 확인",
        routeKind: "official",
        preservesHotel: false,
        status: "official",
        url: "https://www.agoda.com/amexhk",
      },
      {
        id: "jal-jp",
        label: "JAL Mileage Bank Agoda",
        region: "Japan",
        kind: "official partner guide",
        market: "일본",
        eligibility:
          "JAL Mileage Bank 회원 대상. 마일 적립 대상·예약 흐름은 JAL 공식 안내에서 확인",
        routeKind: "official",
        preservesHotel: false,
        status: "official",
        url: "https://www.jal.co.jp/jp/ja/inter/option/hotel/agoda/",
      },
    ];
    const discoveryMetadata: Record<
      string,
      Pick<
        Candidate,
        "market" | "eligibility" | "routeKind" | "preservesHotel" | "status"
      >
    > = {
      "maps-1": {
        market: "글로벌",
        eligibility: "Google Maps 유입 경로로 공개 관찰된 CID 후보",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "maps-2": {
