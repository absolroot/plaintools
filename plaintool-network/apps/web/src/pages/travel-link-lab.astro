---
import SiteLayout from "../layouts/SiteLayout.astro";
import { travelLinkCopy } from "../features/travel-link/copy";
import { absoluteUrl, type Locale } from "../lib/site";
import "../styles/travel-link-lab.css";

interface Props {
  locale?: Locale;
}

const { locale = "ko" } = Astro.props;
const copy = travelLinkCopy[locale];
const marketOptions = [
  ["대한민국", "KR"],
  ["일본", "JP"],
  ["중국 본토", "CN"],
  ["홍콩", "HK"],
  ["대만", "TW"],
  ["싱가포르", "SG"],
  ["말레이시아", "MY"],
  ["태국", "TH"],
  ["베트남", "VN"],
  ["인도네시아", "ID"],
  ["필리핀", "PH"],
  ["호주·뉴질랜드", "ANZ"],
] as const;
const canonical = absoluteUrl(`/${locale}/travel-link-lab/`);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: copy.heading,
    applicationCategory: "TravelApplication",
    operatingSystem: "Any",
    isAccessibleForFree: true,
    url: canonical,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "AbsolTools",
        item: absoluteUrl(`/${locale}/`),
      },
      { "@type": "ListItem", position: 2, name: copy.heading, item: canonical },
    ],
  },
];
---

<SiteLayout
  locale={locale}
  page="travel-link-lab"
  title={copy.title}
  description={copy.description}
  noindex={true}
  structuredData={structuredData}
>
  <section class="tool-intro">
    <div class="tool-intro-copy">
      <h1>{copy.heading}</h1>
      <p class="hero-subheading">{copy.intro}</p>
    </div>
  </section>
  <div class="tool-shell">
    <section
      class="converter travel-link-lab"
      data-travel-lab
      aria-label={copy.heading}
      data-travel-copy={JSON.stringify(copy)}
    >
      <div class="converter-topbar travel-link-lab-topbar">
        <div>
          <strong>{copy.workspaceTitle}</strong>
          <span>{copy.workspaceDescription}</span>
        </div>
      </div>
      <div class="travel-link-lab-input-panel">
        <section class="travel-link-market-picker">
          <label for="travel-market">{copy.marketLabel}</label>
          <select id="travel-market" data-travel-market>
            <option value="">{copy.marketPlaceholder}</option>
            {
              marketOptions.map(([value, code]) => (
                <option value={value}>{copy.markets[code]}</option>
              ))
            }
          </select>
        </section>
        <section class="editor-pane travel-link-lab-input">
          <div class="pane-heading">
            <label for="travel-url">{copy.hotelUrlLabel}</label>
            <div class="pane-actions">
              <button class="text-button" type="button" data-clear
                >{copy.clear}</button
              >
            </div>
          </div>
          <input
            id="travel-url"
            data-travel-url
            spellcheck="false"
            autocomplete="off"
            type="url"
            placeholder={copy.urlPlaceholder}
          />
        </section>
      </div>
      <div class="converter-commandbar">
        <p class="travel-link-lab-error" data-travel-status aria-live="polite">
        </p>
        <div class="primary-actions">
          <button class="primary-button" type="button" data-generate
            >{copy.generate}</button
          >
        </div>
      </div>
    </section>
    <section
      class="travel-link-results"
      data-travel-results
      hidden
      aria-labelledby="travel-results-title"
    >
      <div class="travel-link-results-heading">
        <div>
          <h2 id="travel-results-title">{copy.resultsTitle}</h2>
          <p data-travel-result-summary>{copy.resultsDescription}</p>
        </div>
      </div>
      <div class="travel-link-result-list" data-travel-grid></div>
    </section>
  </div>
  <div class="content-sections">
    <section class="content-section">
      <h2>{copy.paymentTitle}</h2><p>{copy.paymentDescription}</p>
    </section>
  </div>
</SiteLayout>

