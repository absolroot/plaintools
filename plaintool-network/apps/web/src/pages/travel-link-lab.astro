---
import SiteLayout from "../layouts/SiteLayout.astro";
import ToolPromise from "../components/ToolPromise.astro";
import "../styles/travel-link-lab.css";
---

<SiteLayout
  locale="ko"
  title="Agoda 링크 후보 확인 | AbsolTools"
  description="로컬 전용 Agoda CID 후보 링크 생성 연구 화면"
  noindex={true}
  canonicalize={false}
>
  <section class="tool-intro">
    <div class="tool-intro-copy">
      <h1>Agoda 링크 후보 확인</h1>
      <p class="hero-subheading">
        Agoda 호텔 URL 하나로 연구용 CID 후보 링크를 만듭니다. 가격은 불러오지
        않으며, 각 링크는 직접 열어 확인합니다.
      </p>
      <ToolPromise locale="ko" />
    </div>
  </section>
  <div class="tool-shell">
    <section
      class="converter travel-link-lab"
      data-travel-lab
      aria-label="Agoda 링크 후보 생성기"
    >
      <div class="converter-topbar travel-link-lab-topbar">
        <div>
          <strong>연구 후보 카탈로그</strong>
          <span>공개 배포 전 검토 상태 · 가격 조회 및 자동 탭 열기 없음</span>
        </div>
        <span class="travel-link-lab-count" data-travel-count>준비 중</span>
      </div>
      <div class="travel-link-lab-input-panel">
        <section class="editor-pane travel-link-lab-input">
          <div class="pane-heading">
            <label for="travel-url">Agoda 호텔 URL</label>
            <div class="pane-actions">
              <button class="text-button" type="button" data-clear
                >지우기</button
              >
            </div>
          </div>
          <textarea
            id="travel-url"
            data-travel-url
            rows="6"
            spellcheck="false"
            autocomplete="off"
            placeholder="agoda.com/ko-kr/... 또는 https://www.agoda.com/..."
          ></textarea>
          <p class="travel-link-lab-input-note">
            입력값은 이 브라우저 탭 안에서만 처리합니다. 기존 CID·추적값은 새
            링크에 포함하지 않습니다.
          </p>
        </section>
      </div>
      <div class="converter-commandbar">
        <div class="tool-status">
          <div class="status-copy">
            <span class="status-dot" aria-hidden="true"></span><span
              data-travel-status
              aria-live="polite">로컬 후보 카탈로그를 불러오는 중입니다.</span
            >
          </div>
        </div>
        <div class="primary-actions">
          <button class="primary-button" type="button" data-generate
            >후보 링크 만들기</button
          >
        </div>
      </div>
    </section>
    <section
      class="travel-link-results"
      data-travel-results
      hidden
      aria-labelledby="travel-results-title"
    >
      <div class="travel-link-results-heading">
        <div>
          <p class="eyebrow">RESULTS <span>·</span> manual check</p>
          <h2 id="travel-results-title">국가·제휴 유형별 확인 링크</h2>
          <p data-travel-result-summary>
            아래 경로는 입력한 호텔 URL을 유지하는지, 별도 제휴 페이지인지
            구분해 표시합니다.
          </p>
        </div>
        <span class="travel-link-results-total" data-travel-total></span>
      </div>
      <div class="travel-link-filter-set">
        <div>
          <p class="travel-link-filter-label">카드 발급·이용 시장</p>
          <nav
            class="travel-link-filters"
            aria-label="카드 발급·이용 시장 필터"
            data-travel-market-filters
          >
          </nav>
        </div>
        <div>
          <p class="travel-link-filter-label">경로 방식</p>
          <nav class="travel-link-filters" aria-label="경로 방식 필터">
            <button
              type="button"
              class="is-active"
              data-route-filter="all"
              aria-pressed="true">전체</button
            >
            <button type="button" data-route-filter="hotel" aria-pressed="false"
              >호텔 URL 유지</button
            >
            <button
              type="button"
              data-route-filter="official"
              aria-pressed="false">공식 제휴 혜택</button
            >
            <button
              type="button"
              data-route-filter="search"
              aria-pressed="false">검색·지도 경유</button
            >
          </nav>
        </div>
      </div>
      <div class="travel-link-result-list" data-travel-grid></div>
    </section>
  </div>
  <div class="content-sections">
    <section class="content-section">
      <h2>사용 방식</h2><p>
        호텔 상세 페이지 주소를 붙여 넣고 후보 링크를 만든 다음, 조건에 맞는
        경로를 하나씩 Agoda에서 확인합니다. 이 도구는 가격·할인·예약 가능 여부를
        판단하지 않습니다.
      </p>
    </section>
    <section class="content-section">
      <h2>후보 데이터의 상태</h2><p>
        표시되는 CID는 공개 비교 서비스에서 관찰한 연구 후보입니다. 카드 발급
        국가, 결제수단, 숙박 조건 등에 따라 적용되지 않을 수 있으며, 공식 확인이
        끝난 경로만 별도 공개 카탈로그로 승격합니다.
      </p>
    </section>
  </div>
</SiteLayout>

<script is:inline src="/travel-catalog.local.js"></script>
<script>
  type Candidate = {
    id: string;
    label: string;
    region: string;
    kind: string;
    cid?: string;
    market?: string;
    eligibility?: string;
    routeKind?: "hotel" | "search" | "official";
    preservesHotel?: boolean;
    status?: "observed" | "official";
    url?: string;
  };
  declare global {
    interface Window {
      __ABSOL_TRAVEL_CATALOG__?: string;
      __ABSOL_TRAVEL_DISCOVERY__?: string;
    }
  }
  const root = document.querySelector<HTMLElement>("[data-travel-lab]");
  if (root) {
    const input = root.querySelector<HTMLTextAreaElement>("[data-travel-url]")!;
    const generate = root.querySelector<HTMLButtonElement>("[data-generate]")!;
    const clear = root.querySelector<HTMLButtonElement>("[data-clear]")!;
    const status = root.querySelector<HTMLElement>("[data-travel-status]")!;
    const results = document.querySelector<HTMLElement>(
      "[data-travel-results]",
    )!;
    const grid = document.querySelector<HTMLElement>("[data-travel-grid]")!;
    const count = root.querySelector<HTMLElement>("[data-travel-count]")!;
    const total = document.querySelector<HTMLElement>("[data-travel-total]")!;
    const marketFilters = document.querySelector<HTMLElement>(
      "[data-travel-market-filters]",
    )!;
    const routeFilters = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-route-filter]"),
    ];
    const decodeCatalog = (encoded?: string): Candidate[] => {
      if (!encoded) return [];
      try {
        return JSON.parse(
          decodeURIComponent(
            Array.from(
              atob(encoded),
              (c) => `%${c.charCodeAt(0).toString(16).padStart(2, "0")}`,
            ).join(""),
          ),
        ) as Candidate[];
      } catch {
        return [];
      }
    };
    const directMetadata: Record<
