        "베트남 발급 Visa 카드",
      ),
      observedCid("vn-jcb", "베트남", "JCB", "1945992", "베트남 발급 JCB 카드"),
      observedCid(
        "vn-mc",
        "베트남",
        "Mastercard",
        "1889575",
        "베트남 발급 개인 Mastercard",
      ),
      observedCid(
        "id-visa",
        "인도네시아",
        "Visa",
        "1903104",
        "인도네시아 발급 Visa 카드",
      ),
      observedCid(
        "id-jcb",
        "인도네시아",
        "JCB",
        "1945991",
        "인도네시아 발급 JCB 카드",
      ),
      observedCid(
        "id-mc",
        "인도네시아",
        "Mastercard",
        "1822934",
        "인도네시아 발급 개인 Mastercard",
      ),
      observedCid(
        "ph-visa",
        "필리핀",
        "Visa",
        "1619927",
        "필리핀 발급 Visa 카드",
      ),
      observedCid(
        "ph-bdo",
        "필리핀",
        "BDO 카드",
        "1449508",
        "필리핀 발급 BDO 카드",
      ),
      observedCid(
        "au-visa",
        "호주·뉴질랜드",
        "Australia Visa",
        "1889308",
        "호주 발급 Visa 카드",
      ),
      observedCid(
        "nz-visa",
        "호주·뉴질랜드",
        "New Zealand Visa",
        "1889309",
        "뉴질랜드 발급 Visa 카드",
      ),
      observedCid(
        "au-nz-mc",
        "호주·뉴질랜드",
        "Mastercard",
        "1889485",
        "호주·뉴질랜드 발급 개인 Mastercard",
      ),
    ];
    const discoveryMetadata: Record<
      string,
      Pick<
        Candidate,
        | "label"
        | "market"
        | "eligibility"
        | "routeKind"
        | "preservesHotel"
        | "status"
      >
    > = {
      "maps-1": {
        label: "Google 지도 경로 1",
        market: "글로벌",
        eligibility: "공개 지도 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "maps-2": {
        label: "Google 지도 경로 2",
        market: "글로벌",
        eligibility: "공개 지도 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "maps-3": {
        label: "Google 지도 경로 3",
        market: "글로벌",
        eligibility: "공개 지도 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "search-1": {
        label: "Google 검색 경로 1",
        market: "글로벌",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "search-2": {
        label: "Google 검색 경로 2",
        market: "글로벌",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      "search-3": {
        label: "Google 검색 경로 3",
        market: "글로벌",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
      naver: {
        label: "네이버 검색 경로",
        market: "대한민국",
        eligibility: "공개 검색 경로",
        routeKind: "search",
        preservesHotel: true,
        status: "observed",
      },
    };
    const candidates = [
      ...decodeCatalog(window.__ABSOL_TRAVEL_CATALOG__).map((candidate) => ({
        ...candidate,
        ...directMetadata[candidate.id],
      })),
      ...decodeCatalog(window.__ABSOL_TRAVEL_DISCOVERY__).map((candidate) => ({
        ...candidate,
        ...discoveryMetadata[candidate.id],
      })),
      ...regionalCidCandidates,
      ...regionalOffers,
    ];
    const marketByLanguage: Record<string, string> = {
      ko: "대한민국",
      ja: "일본",
      "zh-cn": "중국 본토",
      "zh-tw": "대만",
      "zh-hk": "홍콩",
      en: "싱가포르",
      ms: "말레이시아",
      th: "태국",
      vi: "베트남",
      id: "인도네시아",
      fil: "필리핀",
      tl: "필리핀",
    };
    const preferredLanguage = navigator.language.toLowerCase();
    const preferredMarket =
      marketByLanguage[preferredLanguage] ??
      marketByLanguage[preferredLanguage.split("-")[0]];
    if (preferredMarket) market.value = preferredMarket;
    status.textContent = candidates.length
      ? ""
      : "링크 데이터를 불러오지 못했습니다.";
    generate.disabled = candidates.length === 0;
    const safeHotelUrl = (value: string): URL | null => {
      try {
        const pasted = value.trim().replace(/^[\s"'“”‘’]+|[\s"'“”‘’]+$/g, "");
        const source = new URL(
          /^https?:\/\//i.test(pasted) ? pasted : `https://${pasted}`,
        );
        if (
          source.protocol !== "https:" ||
          !(
            source.hostname === "agoda.com" ||
            source.hostname.endsWith(".agoda.com")
          )
        )
          return null;
        const output = new URL(source.origin + source.pathname);
        [
          "countryId",
          "finalPriceView",
          "isShowMobileAppPrice",
          "numberOfBedrooms",
          "familyMode",
          "adults",
          "children",
          "rooms",
          "maxRooms",
          "checkIn",
          "checkOut",
          "isCalendarCallout",
          "childAges",
          "numberOfGuest",
          "missingChildAges",
          "travellerType",
          "showReviewSubmissionEntry",
          "currencyCode",
          "isFreeOccSearch",
          "tspTypes",
          "los",
        ].forEach((key) => {
          const parameter = source.searchParams.get(key);
          if (parameter !== null) output.searchParams.set(key, parameter);
        });
        return output;
      } catch {
        return null;
      }
    };
    let activeHotel: URL | null = null;
    let activeMarket = market.value;
    let activeRoute = "all";
    const groupLabels: Record<"hotel" | "search" | "official", string> = {
      hotel: "호텔 URL 유지 링크",
      search: "검색·지도 경유 링크",
      official: "공식 혜택 페이지",
    };
    const candidateMatches = (candidate: Candidate) => {
      const marketMatches = candidate.market === activeMarket;
      const routeMatches =
        activeRoute === "all" ||
        (activeRoute === "hotel" && candidate.preservesHotel) ||
        (activeRoute === "official" && candidate.routeKind === "official") ||
        (activeRoute === "search" && candidate.routeKind === "search");
      return marketMatches && routeMatches;
    };
    const renderResults = () => {
      if (!activeHotel) return;
      const visible = candidates.filter(candidateMatches);
      const groups = new Map<string, Map<string, Candidate[]>>();
      visible.forEach((candidate) => {
        const group = candidate.routeKind ?? "hotel";
        const market = candidate.market ?? candidate.region;
        const marketGroups =
          groups.get(group) ?? new Map<string, Candidate[]>();
        marketGroups.set(market, [
          ...(marketGroups.get(market) ?? []),
          candidate,
        ]);
        groups.set(group, marketGroups);
      });
      const fragment = document.createDocumentFragment();
      if (!groups.size) {
        const empty = document.createElement("p");
        empty.className = "travel-link-empty";
        empty.textContent = "선택한 시장과 경로 방식에 맞는 링크가 없습니다.";
        fragment.append(empty);
      }
      groups.forEach((marketGroups, group) => {
        const section = document.createElement("section");
        section.className = "travel-link-result-group";
        const heading = document.createElement("h3");
        heading.textContent =
          groupLabels[group as "hotel" | "search" | "official"] ?? group;
        const marketList = document.createElement("div");
        marketList.className = "travel-link-market-list";
        marketGroups.forEach((groupCandidates, market) => {
          const marketSection = document.createElement("section");
          marketSection.className = "travel-link-market-group";
          const marketHeading = document.createElement("h4");
          marketHeading.textContent = market;
          const list = document.createElement("div");
          list.className = "travel-link-card-list";
          groupCandidates.forEach((candidate) => {
            const card = document.createElement("article");
            card.className = "travel-link-card";
            card.dataset.travelCard = candidate.id;
            const copy = document.createElement("div");
            copy.className = "travel-link-card-copy";
            const title = document.createElement("h4");
            title.textContent = candidate.label;
            const detail = document.createElement("p");
            detail.className = "travel-link-card-detail";
            detail.textContent = `${candidate.preservesHotel ? "입력 URL 유지" : "입력 URL 미유지"} · ${candidate.eligibility ?? "조건 확인"}`;
            copy.append(title, detail);
            const link = document.createElement("a");
            link.className = "secondary-button";
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            if (candidate.routeKind === "official") {
              link.href = candidate.url!;
              link.textContent = "공식 혜택 보기";
            } else {
              const url = new URL(activeHotel!);
              url.searchParams.set("cid", candidate.cid!);
              link.href = url.toString();
              link.textContent = "Agoda에서 확인";
            }
            card.append(copy, link);
            list.append(card);
          });
          marketSection.append(marketHeading, list);
          marketList.append(marketSection);
        });
        section.append(heading, marketList);
        fragment.append(section);
      });
      grid.replaceChildren(fragment);
    };
    const render = () => {
      const hotel = safeHotelUrl(input.value);
      if (!hotel) {
        results.hidden = true;
        root.classList.remove("is-success");
        root.classList.add("has-error");
        status.textContent =
          "https://www.agoda.com/ 형식의 호텔 URL을 붙여 넣어 주세요.";
        input.focus();
        return;
      }
      activeHotel = hotel;
      activeMarket = market.value;
      activeRoute = "all";
      routeFilters.forEach((button) => {
        const active = button.dataset.routeFilter === activeRoute;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      renderResults();
      results.hidden = false;
      root.classList.remove("has-error", "is-success");
      status.textContent = "";
      if (window.matchMedia("(max-width: 680px)").matches)
        results.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    generate.addEventListener("click", render);
    input.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key === "Enter") render();
    });
    clear.addEventListener("click", () => {
      input.value = "";
      results.hidden = true;
      grid.replaceChildren();
      activeHotel = null;
      root.classList.remove("is-success", "has-error");
      status.textContent = candidates.length
        ? ""
        : "링크 데이터를 불러오지 못했습니다.";
      input.focus();
    });
    market.addEventListener("change", () => {
      activeMarket = market.value;
      if (activeHotel) renderResults();
    });
    input.addEventListener("input", () => {
      root.classList.remove("has-error");
    });
    routeFilters.forEach((button) =>
      button.addEventListener("click", () => {
        if (!activeHotel) return;
        activeRoute = button.dataset.routeFilter ?? "all";
        routeFilters.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle("is-active", active);
          candidate.setAttribute("aria-pressed", String(active));
        });
        renderResults();
      }),
    );
  }
</script>
