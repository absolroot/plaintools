      },
    };
    const candidates = [
      ...decodeCatalog(window.__ABSOL_TRAVEL_CATALOG__).map((candidate) => ({
        ...candidate,
        ...directMetadata[candidate.id],
      })),
      ...decodeCatalog(window.__ABSOL_TRAVEL_DISCOVERY__).map((candidate) => ({
        ...candidate,
        ...discoveryMetadata[candidate.id],
      })),
      ...regionalOffers,
    ];
    status.textContent = candidates.length
      ? `${candidates.length}개 연구 후보가 준비되었습니다. URL은 저장되지 않습니다.`
      : "로컬 후보 카탈로그가 없습니다. 배포용 화면에는 후보 CID를 포함하지 않습니다.";
    count.textContent = candidates.length
      ? `${candidates.length}개 후보`
      : "카탈로그 없음";
    generate.disabled = candidates.length === 0;
    const safeHotelUrl = (value: string): URL | null => {
      try {
        const pasted = value.trim().replace(/^[\s"'“”‘’]+|[\s"'“”‘’]+$/g, "");
        const source = new URL(
          /^https?:\/\//i.test(pasted) ? pasted : `https://${pasted}`,
        );
        if (
          source.protocol !== "https:" ||
          !(
            source.hostname === "agoda.com" ||
            source.hostname.endsWith(".agoda.com")
          )
        )
          return null;
        const output = new URL(source.origin + source.pathname);
        [
          "countryId",
          "finalPriceView",
          "isShowMobileAppPrice",
          "numberOfBedrooms",
          "familyMode",
          "adults",
          "children",
          "rooms",
          "maxRooms",
          "checkIn",
          "checkOut",
          "isCalendarCallout",
          "childAges",
          "numberOfGuest",
          "missingChildAges",
          "travellerType",
          "showReviewSubmissionEntry",
          "currencyCode",
          "isFreeOccSearch",
          "tspTypes",
          "los",
        ].forEach((key) => {
          const parameter = source.searchParams.get(key);
          if (parameter !== null) output.searchParams.set(key, parameter);
        });
        return output;
      } catch {
        return null;
      }
    };
    let activeHotel: URL | null = null;
    let activeMarket = "all";
    let activeRoute = "all";
    const groupLabels: Record<"hotel" | "search" | "official", string> = {
      hotel: "입력한 호텔 URL을 유지하는 CID 후보",
      search: "검색·지도 유입 CID 후보",
      official: "국가별 공식 제휴 혜택",
    };
    const routeLabel = (candidate: Candidate) =>
      candidate.routeKind === "official"
        ? "공식 제휴 조건"
        : candidate.routeKind === "search"
          ? "검색·지도 경유"
          : "호텔 URL 유지";
    const renderMarketFilters = () => {
      const markets = [
        "all",
        ...[
          ...new Set(
            candidates.map((candidate) => candidate.market).filter(Boolean),
          ),
        ],
      ] as string[];
      marketFilters.replaceChildren(
        ...markets.map((market) => {
          const button = document.createElement("button");
          const active = market === activeMarket;
          button.type = "button";
          button.dataset.marketFilter = market;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
          const marketCount = candidates.filter(
            (candidate) => market === "all" || candidate.market === market,
          ).length;
          button.textContent = `${market === "all" ? "전체 시장" : market} · ${marketCount}개`;
          button.addEventListener("click", () => {
            if (!activeHotel) return;
            activeMarket = market;
            renderMarketFilters();
            renderResults();
          });
          return button;
        }),
      );
    };
    const candidateMatches = (candidate: Candidate) => {
      const marketMatches =
        activeMarket === "all" || candidate.market === activeMarket;
      const routeMatches =
        activeRoute === "all" ||
        (activeRoute === "hotel" && candidate.preservesHotel) ||
        (activeRoute === "official" && candidate.routeKind === "official") ||
        (activeRoute === "search" && candidate.routeKind === "search");
      return marketMatches && routeMatches;
    };
    const renderResults = () => {
      if (!activeHotel) return;
      const visible = candidates.filter(candidateMatches);
      const groups = new Map<string, Map<string, Candidate[]>>();
      visible.forEach((candidate) => {
        const group = candidate.routeKind ?? "hotel";
        const market = candidate.market ?? candidate.region;
        const marketGroups =
          groups.get(group) ?? new Map<string, Candidate[]>();
        marketGroups.set(market, [
          ...(marketGroups.get(market) ?? []),
          candidate,
        ]);
        groups.set(group, marketGroups);
      });
      const fragment = document.createDocumentFragment();
      if (!groups.size) {
        const empty = document.createElement("p");
        empty.className = "travel-link-empty";
        empty.textContent = "선택한 시장과 경로 방식에 맞는 후보가 없습니다.";
        fragment.append(empty);
      }
      groups.forEach((marketGroups, group) => {
        const section = document.createElement("section");
        section.className = "travel-link-result-group";
        const heading = document.createElement("h3");
        heading.textContent =
          groupLabels[group as "hotel" | "search" | "official"] ?? group;
        const marketList = document.createElement("div");
        marketList.className = "travel-link-market-list";
        marketGroups.forEach((groupCandidates, market) => {
          const marketSection = document.createElement("section");
          marketSection.className = "travel-link-market-group";
          const marketHeading = document.createElement("h4");
          marketHeading.textContent = market;
          const list = document.createElement("div");
          list.className = "travel-link-card-list";
          groupCandidates.forEach((candidate) => {
            const card = document.createElement("article");
            card.className = "travel-link-card";
            card.dataset.travelCard = candidate.id;
            const copy = document.createElement("div");
            copy.className = "travel-link-card-copy";
            const meta = document.createElement("p");
            meta.className = "travel-link-card-meta";
            meta.textContent = `${candidate.market ?? candidate.region} · ${routeLabel(candidate)} · ${candidate.status === "official" ? "공식 확인" : "공개 관찰 후보"}`;
            const title = document.createElement("h4");
            title.textContent = candidate.label;
            const eligibility = document.createElement("p");
            eligibility.className = "travel-link-card-eligibility";
            eligibility.textContent =
              candidate.eligibility ?? "적용 조건을 Agoda에서 확인";
            const routeNote = document.createElement("p");
            routeNote.className = "travel-link-card-route";
            routeNote.textContent = candidate.preservesHotel
              ? "입력한 호텔·날짜·인원 조건을 유지한 새 링크입니다."
              : "호텔 URL은 전달되지 않습니다. 공식 조건을 확인한 뒤 해당 제휴 흐름에서 다시 검색하세요.";
            copy.append(meta, title, eligibility, routeNote);
            const link = document.createElement("a");
            link.className = "secondary-button";
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            if (candidate.routeKind === "official") {
              link.href = candidate.url!;
              link.textContent = "공식 혜택 보기";
            } else {
              const url = new URL(activeHotel!);
              url.searchParams.set("cid", candidate.cid!);
              link.href = url.toString();
              link.textContent = "Agoda에서 확인";
            }
            card.append(copy, link);
            list.append(card);
          });
          marketSection.append(marketHeading, list);
          marketList.append(marketSection);
        });
        section.append(heading, marketList);
        fragment.append(section);
      });
      grid.replaceChildren(fragment);
      total.textContent = `${visible.length}개 경로`;
    };
    const render = () => {
      const hotel = safeHotelUrl(input.value);
      if (!hotel) {
        results.hidden = true;
        root.classList.remove("is-success");
        root.classList.add("has-error");
        status.textContent =
          "https://www.agoda.com/ 형식의 호텔 URL을 붙여 넣어 주세요.";
        input.focus();
        return;
      }
      activeHotel = hotel;
      activeMarket = "all";
      activeRoute = "all";
      renderMarketFilters();
      routeFilters.forEach((button) => {
        const active = button.dataset.routeFilter === activeRoute;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      renderResults();
      results.hidden = false;
      root.classList.remove("has-error");
      root.classList.add("is-success");
      status.textContent =
        "결과를 만들었습니다. 시장과 경로 방식을 고른 뒤 링크를 하나씩 열어 조건을 직접 확인하세요.";
      if (window.matchMedia("(max-width: 680px)").matches)
        results.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    generate.addEventListener("click", render);
    input.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key === "Enter") render();
    });
    clear.addEventListener("click", () => {
      input.value = "";
      results.hidden = true;
      grid.replaceChildren();
      activeHotel = null;
      root.classList.remove("is-success", "has-error");
      status.textContent = candidates.length
        ? "입력을 지웠습니다. URL은 저장되지 않습니다."
        : "로컬 후보 카탈로그가 없습니다.";
      input.focus();
    });
    input.addEventListener("input", () => {
      root.classList.remove("has-error");
    });
    routeFilters.forEach((button) =>
      button.addEventListener("click", () => {
        if (!activeHotel) return;
        activeRoute = button.dataset.routeFilter ?? "all";
        routeFilters.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle("is-active", active);
          candidate.setAttribute("aria-pressed", String(active));
        });
        renderResults();
      }),
    );
  }
</script>
