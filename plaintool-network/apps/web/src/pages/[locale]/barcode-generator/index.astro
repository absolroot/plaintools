---
import GeneratorToolPage from "../../../features/new-tools/GeneratorToolPage.astro";
import { locales, type Locale } from "../../../lib/site";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<GeneratorToolPage locale={locale} page="barcode-generator" />
