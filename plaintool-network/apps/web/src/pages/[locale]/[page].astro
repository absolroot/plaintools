---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CookieDeclaration from "../../components/CookieDeclaration.astro";
import { getCopy, interpolate } from "../../lib/i18n";
import {
  legalPages,
  locales,
  siteConfig,
  type LegalPage,
  type Locale,
} from "../../lib/site";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    legalPages.map((page) => ({
      params: { locale, page },
      props: { locale, page },
    })),
  );
}

interface Props {
  locale: Locale;
  page: LegalPage;
}
const { locale, page } = Astro.props;
const t = getCopy(locale);
const content = t.legal[page];
const analyticsState =
  t.integrationState[
    siteConfig.integrations.ga4MeasurementId ? "enabled" : "disabled"
  ];
const advertisingState =
  t.integrationState[
    siteConfig.integrations.adsensePublisherId ? "enabled" : "disabled"
  ];
const variables = {
  operator: siteConfig.operator.name,
  email: siteConfig.operator.email,
  region: siteConfig.operator.region,
  date: siteConfig.operator.effectiveDate,
  governing_law: siteConfig.operator.governingLaw,
  jurisdiction: siteConfig.operator.jurisdiction,
  host_provider: siteConfig.hosting.provider,
  host_privacy_url: siteConfig.hosting.privacyUrl,
  host_log_retention: siteConfig.hosting.logRetention,
  analytics_state: analyticsState,
  advertising_state: advertisingState,
  consent_provider: "Cookiebot by Usercentrics",
};
---

<SiteLayout
  locale={locale}
  page={page}
  title={`${content.title} · AbsolTools`}
  description={content.intro}
>
  <article class="legal-page">
    <h1>{content.title}</h1>
    <p class="legal-intro">{content.intro}</p>
    {
      content.sections.map((section) => (
        <section class="legal-section">
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => (
            <p>{interpolate(paragraph, variables)}</p>
          ))}
        </section>
      ))
    }
    {page === "cookies" && <CookieDeclaration />}
  </article>
</SiteLayout>
