---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ToolDirectorySearch from "../../components/ToolDirectorySearch.astro";
import ToolMark from "../../components/ToolMark.astro";
import {
  networkCopy,
  toolCatalog,
  toolCardName,
  toolPath,
  type ToolCategory,
} from "../../lib/tool-catalog";
import {
  absoluteUrl,
  locales,
  localizedPath,
  type ToolPage,
} from "../../lib/site";
import { itemListSchema } from "../../lib/seo";
import { buildToolDirectorySearchCorpus } from "../../lib/tool-directory-search";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const n = networkCopy[locale];
const statusLabels = { preview: n.research, reserve: n.reserve } as const;
const categories: ToolCategory[] = [
  "encoding",
  "text",
  "converter",
  "image",
  "data",
  "time",
];
const directoryCategoriesId = "tool-directory-categories";
const toolsForCategory = (category: ToolCategory) => {
  const tools = toolCatalog.filter((tool) => tool.category === category);
  if (category !== "text") return tools;
  return tools.toSorted(
    (left, right) =>
      Number(right.id === "ai-watermark-remover") -
      Number(left.id === "ai-watermark-remover"),
  );
};
const publicItems = toolCatalog
  .filter((tool) => tool.status === "available" && tool.slug)
  .map((tool) => ({
    name: tool.name[locale],
    url: absoluteUrl(localizedPath(locale, tool.slug as ToolPage)),
  }));
---

<SiteLayout
  locale={locale}
  title={n.directoryMetaTitle}
  description={n.directoryMetaDescription}
  structuredData={[itemListSchema(publicItems)]}
>
  <article class="tool-directory">
    <header class="directory-header">
      <h1>{n.directoryTitle}</h1><p>{n.directoryIntro}</p>
    </header>
    <ToolDirectorySearch
      locale={locale}
      targetId={directoryCategoriesId}
      totalCount={toolCatalog.length}
    />
    <div
      class="directory-categories"
      id={directoryCategoriesId}
      aria-label={n.catalogAria}
    >
      {
        categories.map((category) => {
          const tools = toolsForCategory(category);
          return (
            <section class="directory-category" data-directory-search-category>
              <div class="directory-category-heading">
                <>
                  <h2>{n.categories[category]}</h2>
                  <span aria-hidden="true" data-directory-search-category-count>
                    {String(tools.length).padStart(2, "0")}
                  </span>
                </>
              </div>
              <div class="tool-directory-grid">
                {tools.map((tool) => {
                  const href = toolPath(locale, tool);
                  const nameLines = toolCardName(tool, locale).split(" - ");
                  return href ? (
                    <a
                      class:list={["tool-directory-card", `is-${tool.status}`]}
                      href={href}
                      data-directory-search-card
                      data-directory-search-corpus={buildToolDirectorySearchCorpus(
                        tool,
                        locale,
                      )}
                    >
                      <div class="tool-directory-card-heading">
                        <ToolMark toolId={tool.id} mark={tool.mark} />
                        <h3>
                          {nameLines.map((line) => (
                            <span>{line}</span>
                          ))}
                        </h3>
                        {tool.status !== "available" && (
                          <span
                            class:list={[
                              "directory-status",
                              `is-${tool.status}`,
                            ]}
                          >
                            {statusLabels[tool.status]}
                          </span>
                        )}
                      </div>
                      <div class="tool-directory-copy">
                        <p>{tool.summary[locale]}</p>
                      </div>
                    </a>
                  ) : (
                    <article
                      class:list={["tool-directory-card", `is-${tool.status}`]}
                      data-directory-search-card
                      data-directory-search-corpus={buildToolDirectorySearchCorpus(
                        tool,
                        locale,
                      )}
                    >
                      <div class="tool-directory-card-heading">
                        <ToolMark toolId={tool.id} mark={tool.mark} />
                        <h3>
                          {nameLines.map((line) => (
                            <span>{line}</span>
                          ))}
                        </h3>
                        {tool.status !== "available" && (
                          <span
                            class:list={[
                              "directory-status",
                              `is-${tool.status}`,
                            ]}
                          >
                            {statusLabels[tool.status]}
                          </span>
                        )}
                      </div>
                      <div class="tool-directory-copy">
                        <p>{tool.summary[locale]}</p>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })
      }
    </div>
  </article>
</SiteLayout>
