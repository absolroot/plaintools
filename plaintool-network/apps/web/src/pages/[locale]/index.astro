---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ToolDirectoryCard from "../../components/ToolDirectoryCard.astro";
import ToolDirectorySearch from "../../components/ToolDirectorySearch.astro";
import ToolDirectorySection from "../../components/ToolDirectorySection.astro";
import UiIcon from "../../components/UiIcon.astro";
import { imageConverterLocales } from "../../features/image-converter/i18n";
import { parseImageConversionMode } from "../../features/image-converter/formats";
import {
  networkCopy,
  toolCatalog,
  type ToolCategory,
} from "../../lib/tool-catalog";
import {
  absoluteUrl,
  locales,
  localizedPath,
  type ToolPage,
} from "../../lib/site";
import { itemListSchema } from "../../lib/seo";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const n = networkCopy[locale];
const categoriesBeforeImageConversion: ToolCategory[] = [
  "image",
  "text",
  "encoding",
  "time",
  "converter",
];
const categoriesAfterImageConversion: ToolCategory[] = ["generator", "data"];
const directoryCategoriesId = "tool-directory-categories";
const toolsForCategory = (category: ToolCategory) => {
  const tools = toolCatalog.filter(
    (tool) => tool.category === category && !parseImageConversionMode(tool.id),
  );
  if (category !== "text") return tools;
  return tools.toSorted(
    (left, right) =>
      Number(right.id === "ai-watermark-remover") -
      Number(left.id === "ai-watermark-remover"),
  );
};
const imageConverterTools = toolCatalog.filter((tool) =>
  parseImageConversionMode(tool.id),
);
const popularImageConverterIds = [
  "png-to-jpg",
  "jpg-to-png",
  "webp-to-jpg",
] as const;
const popularImageConverters = popularImageConverterIds.map((id) => {
  const tool = imageConverterTools.find((candidate) => candidate.id === id);
  if (!tool) throw new Error(`Missing popular image converter: ${id}`);
  return tool;
});
const remainingImageConverters = imageConverterTools.filter(
  (tool) => !popularImageConverterIds.some((id) => id === tool.id),
);
const primaryImageConverter = imageConverterTools.find(
  (tool) => tool.id === "png-to-webp",
);
if (!primaryImageConverter) throw new Error("Missing primary image converter");
const imageConverterTitle =
  imageConverterLocales[locale].tools["png-to-webp"].feature.ariaLabel;
const publicItems = toolCatalog
  .filter((tool) => tool.status === "available" && tool.slug)
  .map((tool) => ({
    name: tool.name[locale],
    url: absoluteUrl(localizedPath(locale, tool.slug as ToolPage)),
  }));
---

<SiteLayout
  locale={locale}
  title={n.directoryMetaTitle}
  description={n.directoryMetaDescription}
  structuredData={[itemListSchema(publicItems)]}
>
  <article class="tool-directory">
    <header class="directory-header">
      <h1>{n.directoryTitle}</h1><p>{n.directoryIntro}</p>
    </header>
    <ToolDirectorySearch
      locale={locale}
      targetId={directoryCategoriesId}
      totalCount={toolCatalog.length}
    />
    <div
      class="directory-categories"
      id={directoryCategoriesId}
      aria-label={n.catalogAria}
    >
      {
        categoriesBeforeImageConversion.map((category) => (
          <ToolDirectorySection
            category={category}
            title={n.categories[category]}
            tools={toolsForCategory(category)}
            locale={locale}
          />
        ))
      }
      <section
        class="directory-category image-converter-directory"
        data-directory-search-category
        data-directory-category="image-converter"
        data-image-converter-directory
      >
        <div class="directory-category-heading">
          <h2>{imageConverterTitle}</h2>
          <span aria-hidden="true" data-directory-search-category-count>
            {String(imageConverterTools.length).padStart(2, "0")}
          </span>
        </div>
        <div class="tool-directory-grid image-converter-featured-grid">
          <ToolDirectoryCard
            tool={primaryImageConverter}
            locale={locale}
            displayName={imageConverterTitle}
            mark="IMG"
            markId="image-converter"
            searchable={false}
          />
          {
            popularImageConverters.map((tool) => (
              <ToolDirectoryCard tool={tool} locale={locale} />
            ))
          }
        </div>
        <details class="image-converter-more" data-directory-search-more>
          <summary>
            <span>{n.allTools}</span>
            <span class="image-converter-more-count" aria-hidden="true">
              {String(remainingImageConverters.length).padStart(2, "0")}
            </span>
            <UiIcon
              name="chevron-right"
              size={16}
              class="image-converter-more-icon"
            />
          </summary>
          <div class="tool-directory-grid image-converter-more-grid">
            {
              remainingImageConverters.map((tool) => (
                <ToolDirectoryCard tool={tool} locale={locale} />
              ))
            }
          </div>
        </details>
      </section>
      {
        categoriesAfterImageConversion.map((category) => (
          <ToolDirectorySection
            category={category}
            title={n.categories[category]}
            tools={toolsForCategory(category)}
            locale={locale}
          />
        ))
      }
    </div>
  </article>
</SiteLayout>
