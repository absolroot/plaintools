---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ToolDirectorySearch from "../../components/ToolDirectorySearch.astro";
import ToolDirectorySection from "../../components/ToolDirectorySection.astro";
import {
  homeDirectoryCategoryOrder,
  homeDirectoryInitiallyVisibleToolCount,
  homeDirectoryToolsForCategory,
  homeDirectoryToolsInDisplayOrder,
  networkCopy,
} from "../../lib/tool-catalog";
import {
  absoluteUrl,
  locales,
  localizedPath,
  type ToolPage,
} from "../../lib/site";
import { itemListSchema } from "../../lib/seo";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const n = networkCopy[locale];
const directoryCategoriesId = "tool-directory-categories";
const publicItems = homeDirectoryToolsInDisplayOrder
  .filter((tool) => tool.status === "available" && tool.slug)
  .map((tool) => ({
    name: tool.name[locale],
    url: absoluteUrl(localizedPath(locale, tool.slug as ToolPage)),
  }));
---

<SiteLayout
  locale={locale}
  title={n.directoryMetaTitle}
  description={n.directoryMetaDescription}
  structuredData={[itemListSchema(publicItems)]}
>
  <article class="tool-directory">
    <header class="directory-header">
      <h1>{n.directoryTitle}</h1><p>{n.directoryIntro}</p>
    </header>
    <ToolDirectorySearch
      locale={locale}
      targetId={directoryCategoriesId}
      totalCount={homeDirectoryToolsInDisplayOrder.length}
    />
    <div
      class="directory-categories"
      id={directoryCategoriesId}
      aria-label={n.catalogAria}
    >
      {
        homeDirectoryCategoryOrder.map((category) => (
          <ToolDirectorySection
            category={category}
            title={n.categories[category]}
            tools={homeDirectoryToolsForCategory(category)}
            locale={locale}
            initiallyVisibleToolCount={homeDirectoryInitiallyVisibleToolCount(
              category,
            )}
            collapsedLabel={n.allTools}
          />
        ))
      }
    </div>
  </article>
</SiteLayout>
