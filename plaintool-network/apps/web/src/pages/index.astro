<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    />
    <meta name="robots" content="noindex,follow" />
    <title>AbsolTools</title>
    <link rel="canonical" href="/en/" />
  </head>
  <body>
    <p><a href="/en/">Continue to all tools</a></p>
    <script>
      import { detectPreferredLocale } from "../lib/locale-detection";

      const locale = detectPreferredLocale(navigator.languages);
      window.location.replace(`/${locale}/`);
    </script>
  </body>
</html>
