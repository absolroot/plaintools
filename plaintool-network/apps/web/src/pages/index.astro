---
import ToolDirectoryPage from "../components/ToolDirectoryPage.astro";
---

<!-- Serve real directory content and links before any locale JavaScript runs.
     The shared layout keeps /en/ canonical and preview builds non-indexable. -->
<ToolDirectoryPage locale="en" includeIntegrations={false}>
  <Fragment slot="head">
    <meta name="yandex-verification" content="0d6a774441a1b957" />
    <script is:inline src="/root-locale.js"></script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
  </Fragment>
</ToolDirectoryPage>
