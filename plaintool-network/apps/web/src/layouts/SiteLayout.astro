---
import "../styles/global.css";
import { getCopy } from "../lib/i18n";
import { localeMetadata } from "../lib/locale-data";
import { networkCopy } from "../lib/tool-catalog";
import { toolCatalog } from "../lib/tool-catalog";
import {
  absoluteUrl,
  legalPages,
  locales,
  localizedPath,
  siteConfig,
  type ContentPage,
  type Locale,
  type ToolPage,
} from "../lib/site";
import type { StructuredData } from "../lib/seo";
import UiIcon from "../components/UiIcon.astro";
import LanguageFlag from "../components/LanguageFlag.astro";
import RelatedTools from "../components/RelatedTools.astro";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  page?: ContentPage;
  noindex?: boolean;
  canonicalize?: boolean;
  structuredData?: StructuredData[];
  featureStylesheet?: string;
}

const {
  locale,
  title,
  description,
  page,
  noindex = false,
  canonicalize = true,
  structuredData = [],
  featureStylesheet,
} = Astro.props;
const t = getCopy(locale);
const n = networkCopy[locale];
const currentTool = toolCatalog.find((tool) => tool.slug === page);
const currentPageLabel =
  currentTool?.name[locale] ??
  (page && legalPages.includes(page as (typeof legalPages)[number])
    ? t.legalNav[page as (typeof legalPages)[number]]
    : undefined);
const pageNoindex = noindex || currentTool?.status === "preview";
const path = localizedPath(locale, page);
const canonical = absoluteUrl(path);
const siteUrl = absoluteUrl("/");
const pageTitle = title || t.metaTitle;
const pageDescription = description || t.metaDescription;
const { direction, ogLocale } = localeMetadata[locale];
const robots = !siteConfig.productionReady
  ? "noindex,nofollow"
  : pageNoindex
    ? "noindex,follow"
    : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const graph: StructuredData[] = canonicalize
  ? [
      {
        "@type": "WebSite",
        "@id": `${siteUrl}#website`,
        url: siteUrl,
        name: "AbsolTools",
        inLanguage: locales,
      },
      {
        "@type": "WebPage",
        "@id": `${canonical}#webpage`,
        url: canonical,
        name: pageTitle,
        description: pageDescription,
        inLanguage: locale,
        isPartOf: { "@id": `${siteUrl}#website` },
      },
      ...structuredData,
    ]
  : [];
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</gu, "\\u003c");
const integrationActive = Boolean(
  siteConfig.integrations.adsensePublisherId ||
    siteConfig.integrations.ga4MeasurementId,
);
const contentSecurityPolicy =
  "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'";
---

<!doctype html>
<html lang={locale} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content={contentSecurityPolicy}
        />
      )
    }
    <meta name="theme-color" content="#fafafa" data-theme-color />
    <script is:inline src="/theme-init.js"></script>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="license" href="/third-party-notices.txt" />
    <link rel="sitemap" href="/sitemap.xml" />
    {featureStylesheet && <link rel="stylesheet" href={featureStylesheet} />}
    <meta name="robots" content={robots} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalize && <link rel="canonical" href={canonical} />}
    {
      canonicalize &&
        locales.map((targetLocale) => (
          <link
            rel="alternate"
            hreflang={targetLocale}
            href={absoluteUrl(localizedPath(targetLocale, page))}
          />
        ))
    }
    {
      canonicalize && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={absoluteUrl(localizedPath("en", page))}
        />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AbsolTools" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalize && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale} />
    {
      locales
        .filter((targetLocale) => targetLocale !== locale)
        .map((targetLocale) => (
          <meta
            property="og:locale:alternate"
            content={localeMetadata[targetLocale].ogLocale}
          />
        ))
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {
      graph.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          data-page-schema
          set:html={jsonLd}
        />
      )
    }
  </head>
  <body
    data-locale={locale}
    data-integrations={integrationActive ? "enabled" : "disabled"}
  >
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <header class="site-header" data-site-header>
      <div class="header-inner">
        <div class="header-branding">
          <a class="wordmark" href={localizedPath(locale)}>
            <span>{t.brandName}</span>
          </a>
          {
            currentPageLabel && (
              <div
                class="header-context"
                aria-label={currentPageLabel}
                data-header-context
              >
                <UiIcon name="chevron-right" size={14} />
                <span data-header-context-label>{currentPageLabel}</span>
              </div>
            )
          }
        </div>
        <div class="header-actions">
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            data-use-light-label={n.useLightTheme}
            data-use-dark-label={n.useDarkTheme}
            aria-label={n.useDarkTheme}
          >
            <span data-theme-icon="dark"><UiIcon name="moon" size={18} /></span>
            <span data-theme-icon="light"><UiIcon name="sun" size={18} /></span>
          </button>
          <a
            class="tool-index-link"
            href={localizedPath(locale)}
            aria-label={n.allTools}
            aria-current={!page ? "page" : undefined}
          >
            <UiIcon name="grid" size={14} />
            <span class="tool-index-label">{n.allTools}</span>
          </a>
          <details class="language-menu" data-language-menu>
            <summary>
              <UiIcon name="languages" size={14} />
              <span>{t.languageName}</span>
              <UiIcon
                name="chevron-right"
                size={14}
                class="language-menu-chevron"
              />
            </summary>
            <nav class="language-menu-panel" aria-label={t.languageNavLabel}>
              {
                locales.map((targetLocale) => {
                  const target = getCopy(targetLocale);
                  const active = targetLocale === locale;
                  return (
                    <a
                      href={localizedPath(targetLocale, page)}
                      lang={targetLocale}
                      dir="ltr"
                      hreflang={targetLocale}
                      aria-current={active ? "page" : undefined}
                      data-locale-link
                    >
                      <LanguageFlag
                        country={localeMetadata[targetLocale].flagCountry}
                      />
                      <span
                        class="language-menu-name"
                        lang={targetLocale}
                        dir={localeMetadata[targetLocale].direction}
                      >
                        {target.languageName}
                      </span>
                      {active && <UiIcon name="check" size={14} />}
                    </a>
                  );
                })
              }
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
      {
        currentTool && page && (
          <RelatedTools locale={locale} currentPage={page as ToolPage} />
        )
      }
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="footer-brand" href={localizedPath(locale)}>AbsolTools</a>
          <p>{n.footerNote}</p>
        </div>
        <nav class="footer-links" aria-label={t.legalNavLabel}>
          <a href={localizedPath(locale)}>{n.allTools}</a>
          {
            legalPages.map((legalPage) => (
              <a href={localizedPath(locale, legalPage)}>
                {t.legalNav[legalPage]}
              </a>
            ))
          }
        </nav>
        <nav class="footer-languages" aria-label={t.languageNavLabel}>
          {
            locales.map((targetLocale) => (
              <a
                href={localizedPath(targetLocale, page)}
                lang={targetLocale}
                dir={localeMetadata[targetLocale].direction}
                hreflang={targetLocale}
                data-locale-link
              >
                {getCopy(targetLocale).languageName}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );
      const themeColor =
        document.querySelector<HTMLMetaElement>("[data-theme-color]");
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
      const syncTheme = () => {
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme && systemDark.matches);
        if (themeColor) themeColor.content = dark ? "#202124" : "#fafafa";
        if (themeToggle) {
          themeToggle.dataset.currentTheme = dark ? "dark" : "light";
          themeToggle.ariaLabel = dark
            ? themeToggle.dataset.useLightLabel || ""
            : themeToggle.dataset.useDarkLabel || "";
        }
      };
      if (themeToggle) {
        themeToggle.addEventListener("click", () => {
          const value =
            themeToggle.dataset.currentTheme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = value;
          try {
            localStorage.setItem("plaintool.theme", value);
          } catch {}
          syncTheme();
        });
      }
      systemDark.addEventListener?.("change", syncTheme);
      syncTheme();
      const languageMenus = document.querySelectorAll<HTMLDetailsElement>(
        "[data-language-menu]",
      );
      const siteHeader =
        document.querySelector<HTMLElement>("[data-site-header]");
      const mobileHeaderQuery = window.matchMedia("(max-width: 680px)");
      let previousScrollY = Math.max(window.scrollY, 0);
      let headerScrollFrame = 0;
      const revealHeader = () =>
        siteHeader?.classList.remove("is-scroll-hidden");
      const syncHeaderToScroll = () => {
        headerScrollFrame = 0;
        if (!siteHeader || !mobileHeaderQuery.matches) {
          revealHeader();
          previousScrollY = Math.max(window.scrollY, 0);
          return;
        }
        const currentScrollY = Math.max(window.scrollY, 0);
        const delta = currentScrollY - previousScrollY;
        const menuOpen = Array.from(languageMenus).some((menu) => menu.open);
        if (currentScrollY <= 24 || delta < -4 || menuOpen) revealHeader();
        else if (delta > 4 && currentScrollY > siteHeader.offsetHeight + 24)
          siteHeader.classList.add("is-scroll-hidden");
        previousScrollY = currentScrollY;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!headerScrollFrame)
            headerScrollFrame =
              window.requestAnimationFrame(syncHeaderToScroll);
        },
        { passive: true },
      );
      mobileHeaderQuery.addEventListener?.("change", () => {
        previousScrollY = Math.max(window.scrollY, 0);
        revealHeader();
      });
      siteHeader?.addEventListener("focusin", revealHeader);
      languageMenus.forEach((menu) =>
        menu.addEventListener("toggle", () => {
          if (menu.open) revealHeader();
        }),
      );
      if (mobileHeaderQuery.matches)
        document
          .querySelectorAll<HTMLDetailsElement>(".faq-list details[open]")
          .forEach((item) => item.removeAttribute("open"));
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;
        languageMenus.forEach((menu) => {
          if (!menu.contains(target)) menu.removeAttribute("open");
        });
      });
      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "Escape") return;
          languageMenus.forEach((menu) => {
            if (!menu.open) return;
            event.preventDefault();
            menu.removeAttribute("open");
            menu.querySelector<HTMLElement>("summary")?.focus();
          });
        },
        true,
      );
    </script>
  </body>
</html>
